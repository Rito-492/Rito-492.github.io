---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import ProfileCard from '../components/ProfileCard.astro';
import MobileToc from '../components/MobileToc.astro';
import ContentShell from '../components/ContentShell.astro';
import { SITE } from '../config';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/sidebar.css';
import '../styles/layouts.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	jsonLd?: Record<string, unknown>;
	licenseUrl?: string;
	showToc?: boolean;
	tocHeadings?: Array<{ depth: number; text: string; id: string }>;
}

const {
	title,
	description = SITE.description,
	image = '/og-image.png',
	type = 'website',
	jsonLd,
	licenseUrl,
	showToc = false,
	tocHeadings = [],
} = Astro.props;

const is404Page = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<SeoHead
			title={title}
			description={description}
			image={image}
			type={type}
			jsonLd={jsonLd}
			licenseUrl={licenseUrl}
		/>
	</head>
	<body>
		<Header title={SITE.title} />

		{is404Page ? (
			<ContentShell fullWidth={true}>
				<slot />
			</ContentShell>
		) : (
			<div class="page-shell">
				<aside class="page-left">
					<ProfileCard />
				</aside>

				<ContentShell>
					<slot />
				</ContentShell>

				<!-- 右栏：页面上下文（目录 / 筛选 / 站点信息），由页面按需提供 -->
				<slot name="right" />

				{showToc && tocHeadings.length > 0 && <MobileToc tocHeadings={tocHeadings} />}
			</div>
		)}

		<Footer />

		<!-- 鼠标点击特效容器 -->
		<div id="click-effects"></div>

		<script>
			import { GOATCOUNTER } from '../config';

			// ── 全局交互（View Transitions 安全：文档级监听只绑一次，元素每次导航后重新查询） ──

			// 滚动进度条 & 返回顶部
			let ticking = false;
			window.addEventListener(
				'scroll',
				() => {
					const scrollProgress = document.getElementById('scrollProgress');
					const backToTopBtn = document.getElementById('backToTop');
					if (!scrollProgress || !backToTopBtn || ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						const scrollTop = window.scrollY;
						const docHeight =
							document.documentElement.scrollHeight -
							document.documentElement.clientHeight;
						scrollProgress.style.width = (scrollTop / docHeight) * 100 + '%';
						backToTopBtn.classList.toggle('visible', scrollTop > 300);
						ticking = false;
					});
				},
				{ passive: true },
			);

			// 返回顶部（事件委托）
			document.addEventListener('click', (e) => {
				const target = e.target instanceof Element ? e.target.closest('#backToTop') : null;
				if (target) window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// 鼠标点击特效（事件委托）
			document.addEventListener('click', (e) => {
				if (!(e instanceof MouseEvent)) return;
				const container = document.getElementById('click-effects');
				if (!container) return;

				const ripple = document.createElement('div');
				ripple.className = 'click-ripple';
				ripple.style.left = e.clientX + 'px';
				ripple.style.top = e.clientY + 'px';
				container.appendChild(ripple);

				for (let i = 0; i < 8; i++) {
					const particle = document.createElement('div');
					particle.className = 'click-particle';
					particle.style.left = e.clientX + 'px';
					particle.style.top = e.clientY + 'px';

					const angle = (i / 8) * Math.PI * 2;
					const velocity = 30 + Math.random() * 30;
					particle.style.setProperty('--tx', Math.cos(angle) * velocity + 'px');
					particle.style.setProperty('--ty', Math.sin(angle) * velocity + 'px');

					container.appendChild(particle);
				}

				setTimeout(() => ripple.remove(), 650);
				setTimeout(() => {
					container.querySelectorAll('.click-particle').forEach((p) => p.remove());
				}, 550);
			});

			// 博客 / About 目录高亮（文档级滚动监听只绑一次；每次实时查询 DOM）
			// 取「已滚过顶部 120px 的最后一个标题」为当前项；触底时强制落到最后一项
			const syncTocHighlight = () => {
				const tocNav = document.getElementById('tocNav');
				if (!tocNav) return;
				const headings = Array.from(
					document.querySelectorAll<HTMLElement>(
						'.post-content h2[id], .post-content h3[id], .about-content h2[id], .about-content h3[id]',
					),
				);
				if (headings.length === 0) return;

				let current = headings[0];
				for (const heading of headings) {
					if (heading.getBoundingClientRect().top <= 120) current = heading;
					else break;
				}
				const atBottom =
					window.innerHeight + window.scrollY >=
					document.documentElement.scrollHeight - 2;
				if (atBottom) current = headings[headings.length - 1];

				tocNav.querySelectorAll('a').forEach((link) => {
					link.classList.toggle(
						'active',
						link.getAttribute('href') === `#${current.id}`,
					);
				});
			};

			let tocTicking = false;
			window.addEventListener(
				'scroll',
				() => {
					if (tocTicking) return;
					tocTicking = true;
					requestAnimationFrame(() => {
						syncTocHighlight();
						tocTicking = false;
					});
				},
				{ passive: true },
			);
			document.addEventListener('astro:page-load', syncTocHighlight);

			// 右栏溢出检测：竖向溢出时底部渐隐（悬停显示滚动条）
			const markOverflowingPanels = () => {
				document.querySelectorAll<HTMLElement>('.side-panel').forEach((panel) => {
					panel.classList.toggle(
						'is-overflowing',
						panel.scrollHeight > panel.clientHeight + 2,
					);
				});
			};

			// 右栏单项横向溢出：单行 + 右缘渐隐，悬停向左滚动
			const markTruncatedItems = () => {
				document
					.querySelectorAll<HTMLElement>(
						'.side-panel .side-panel-item, .side-panel .toc-item a, .side-panel .toc-series span, .side-panel .side-panel-title span, .side-panel .tag-pill',
					)
					.forEach((el) => {
						el.classList.add('scroll-text');
						el.classList.toggle(
							'is-truncated',
							el.scrollWidth > el.clientWidth + 1,
						);
					});
			};

			document.addEventListener('astro:page-load', () => {
				markOverflowingPanels();
				markTruncatedItems();
			});
			window.addEventListener(
				'resize',
				() => {
					markOverflowingPanels();
					markTruncatedItems();
				},
				{ passive: true },
			);
			if (document.fonts) {
				document.fonts.ready.then(() => {
					markOverflowingPanels();
					markTruncatedItems();
				});
			}

			// 悬停：向左滚到末尾；移出：回到开头（文档级委托，只绑一次）
			document.addEventListener('mouseover', (e) => {
				const target = e.target instanceof Element ? e.target : null;
				const el = target?.closest<HTMLElement>('.side-panel .scroll-text.is-truncated');
				if (!el) return;
				if (e.relatedTarget instanceof Node && el.contains(e.relatedTarget)) return;
				el.scrollTo({ left: el.scrollWidth, behavior: 'smooth' });
			});
			document.addEventListener('mouseout', (e) => {
				const target = e.target instanceof Element ? e.target : null;
				const el = target?.closest<HTMLElement>('.side-panel .scroll-text.is-truncated');
				if (!el) return;
				if (e.relatedTarget instanceof Node && el.contains(e.relatedTarget)) return;
				el.scrollTo({ left: 0, behavior: 'smooth' });
			});

			// GoatCounter 统计：load 之后动态注入脚本（绝不拖延 load 事件与 astro:page-load），
			// SPA 模式（no_onload）由本脚本在每次 astro:page-load 手动上报
			(window as any).goatcounter = { no_onload: true };
			const gcInject = () => {
				if (document.querySelector('script[data-goatcounter]')) return;
				const script = document.createElement('script');
				script.async = true;
				script.src = 'https://gc.zgo.at/count.js';
				script.setAttribute(
					'data-goatcounter',
					`https://${GOATCOUNTER.code}.goatcounter.com/count`,
				);
				document.head.appendChild(script);
			};
			if (document.readyState === 'complete') {
				window.setTimeout(gcInject, 0);
			} else {
				window.addEventListener('load', () => window.setTimeout(gcInject, 0), { once: true });
			}

			let gcPendingPath = '';
			let gcTimer: number | null = null;
			const gcSend = () => {
				const gc = (window as any).goatcounter;
				if (gc && typeof gc.count === 'function') {
					gc.count({ path: gcPendingPath });
					return true;
				}
				return false;
			};
			document.addEventListener('astro:page-load', () => {
				gcPendingPath = location.pathname + location.search;
				if (gcSend()) return;
				if (gcTimer !== null) return; // 已有等待中的上报，最新路径生效
				let tries = 0;
				gcTimer = window.setInterval(() => {
					if (gcSend() || ++tries > 20) {
						clearInterval(gcTimer as number);
						gcTimer = null;
					}
				}, 500);
			});
		</script>
	</body>
</html>
