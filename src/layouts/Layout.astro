---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import ProfileCard from '../components/ProfileCard.astro';
import TocSidebar from '../components/TocSidebar.astro';
import MobileToc from '../components/MobileToc.astro';
import ContentShell from '../components/ContentShell.astro';
import { SITE } from '../config';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/layouts.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	jsonLd?: Record<string, unknown>;
	licenseUrl?: string;
	showToc?: boolean;
	tocHeadings?: Array<{ depth: number; text: string; id: string }>;
	series?: string;
	postTitle?: string;
	tags?: string[];
}

const {
	title,
	description = SITE.description,
	image = '/og-image.png',
	type = 'website',
	jsonLd,
	licenseUrl,
	showToc = false,
	tocHeadings = [],
	series = '',
	postTitle = '',
	tags = [],
} = Astro.props;

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const isBlogListPage = Astro.url.pathname.replace(/\/$/, '') === '/blog';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<SeoHead
			title={title}
			description={description}
			image={image}
			type={type}
			jsonLd={jsonLd}
			licenseUrl={licenseUrl}
		/>
	</head>
	<body>
		<Header title={SITE.title} />

		{isHomePage ? (
			<div class="layout-container home-layout">
				<aside class="sidebar-column">
					<ProfileCard />
				</aside>
				<ContentShell>
					<slot />
				</ContentShell>
			</div>
		) : showToc && tocHeadings.length > 0 ? (
			<div class="post-layout full-width">
				<ContentShell>
					<slot />
				</ContentShell>
				<TocSidebar
					series={series}
					postTitle={postTitle}
					tags={tags}
					tocHeadings={tocHeadings}
				/>
				<MobileToc tocHeadings={tocHeadings} />
			</div>
		) : isBlogListPage ? (
			<slot />
		) : (
			<ContentShell fullWidth={true}>
				<slot />
			</ContentShell>
		)}

		<Footer />

		<!-- 鼠标点击特效容器 -->
		<div id="click-effects"></div>

		<script>
			import { GOATCOUNTER } from '../config';

			// ── 全局交互（View Transitions 安全：文档级监听只绑一次，元素每次导航后重新查询） ──

			// 滚动进度条 & 返回顶部
			let ticking = false;
			window.addEventListener(
				'scroll',
				() => {
					const scrollProgress = document.getElementById('scrollProgress');
					const backToTopBtn = document.getElementById('backToTop');
					if (!scrollProgress || !backToTopBtn || ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						const scrollTop = window.scrollY;
						const docHeight =
							document.documentElement.scrollHeight -
							document.documentElement.clientHeight;
						scrollProgress.style.width = (scrollTop / docHeight) * 100 + '%';
						backToTopBtn.classList.toggle('visible', scrollTop > 300);
						ticking = false;
					});
				},
				{ passive: true },
			);

			// 返回顶部（事件委托）
			document.addEventListener('click', (e) => {
				const target = e.target instanceof Element ? e.target.closest('#backToTop') : null;
				if (target) window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// 鼠标点击特效（事件委托）
			document.addEventListener('click', (e) => {
				if (!(e instanceof MouseEvent)) return;
				const container = document.getElementById('click-effects');
				if (!container) return;

				const ripple = document.createElement('div');
				ripple.className = 'click-ripple';
				ripple.style.left = e.clientX + 'px';
				ripple.style.top = e.clientY + 'px';
				container.appendChild(ripple);

				for (let i = 0; i < 8; i++) {
					const particle = document.createElement('div');
					particle.className = 'click-particle';
					particle.style.left = e.clientX + 'px';
					particle.style.top = e.clientY + 'px';

					const angle = (i / 8) * Math.PI * 2;
					const velocity = 30 + Math.random() * 30;
					particle.style.setProperty('--tx', Math.cos(angle) * velocity + 'px');
					particle.style.setProperty('--ty', Math.sin(angle) * velocity + 'px');

					container.appendChild(particle);
				}

				setTimeout(() => ripple.remove(), 650);
				setTimeout(() => {
					container.querySelectorAll('.click-particle').forEach((p) => p.remove());
				}, 550);
			});

			// 博客目录高亮（每次导航重建 observer，先断开旧的）
			let tocObserver: IntersectionObserver | null = null;
			const initTocHighlight = () => {
				tocObserver?.disconnect();
				tocObserver = null;
				const tocNav = document.getElementById('tocNav');
				if (!tocNav) return;

				const tocLinks = tocNav.querySelectorAll('a');
				tocObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								tocLinks.forEach((link) => {
									link.classList.remove('active');
									if (link.getAttribute('href') === `#${entry.target.id}`) {
										link.classList.add('active');
									}
								});
							}
						});
					},
					{ rootMargin: '-100px 0px -60% 0px' },
				);

				document
					.querySelectorAll('.post-content h2, .post-content h3')
					.forEach((heading) => {
						tocObserver?.observe(heading);
					});
			};
			document.addEventListener('astro:page-load', initTocHighlight);

			// GoatCounter 统计：load 之后动态注入脚本（绝不拖延 load 事件与 astro:page-load），
			// SPA 模式（no_onload）由本脚本在每次 astro:page-load 手动上报
			(window as any).goatcounter = { no_onload: true };
			const gcInject = () => {
				if (document.querySelector('script[data-goatcounter]')) return;
				const script = document.createElement('script');
				script.async = true;
				script.src = 'https://gc.zgo.at/count.js';
				script.setAttribute(
					'data-goatcounter',
					`https://${GOATCOUNTER.code}.goatcounter.com/count`,
				);
				document.head.appendChild(script);
			};
			if (document.readyState === 'complete') {
				window.setTimeout(gcInject, 0);
			} else {
				window.addEventListener('load', () => window.setTimeout(gcInject, 0), { once: true });
			}

			let gcPendingPath = '';
			let gcTimer: number | null = null;
			const gcSend = () => {
				const gc = (window as any).goatcounter;
				if (gc && typeof gc.count === 'function') {
					gc.count({ path: gcPendingPath });
					return true;
				}
				return false;
			};
			document.addEventListener('astro:page-load', () => {
				gcPendingPath = location.pathname + location.search;
				if (gcSend()) return;
				if (gcTimer !== null) return; // 已有等待中的上报，最新路径生效
				let tries = 0;
				gcTimer = window.setInterval(() => {
					if (gcSend() || ++tries > 20) {
						clearInterval(gcTimer as number);
						gcTimer = null;
					}
				}, 500);
			});
		</script>
	</body>
</html>
