---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/components.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	showSidebar?: boolean;
	showToc?: boolean;
	tocHeadings?: Array<{ depth: number; text: string; id: string }>;
	series?: string;
	postTitle?: string;
	tags?: string[];
}

const {
	title,
	description = "Rito-492 的个人网站",
	image = "/og-image.png",
	type = "website",
	showSidebar = false,
	showToc = false,
	tocHeadings = [],
	series = "",
	postTitle = "",
	tags = []
} = Astro.props;

const siteUrl = "https://rito-492.github.io";
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

// 判断是否是首页
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const isBlogListPage = Astro.url.pathname.replace(/\/$/, '') === '/blog';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- 字体引入：JetBrains Mono + 霞鹜文楷 -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@callmebill/lxgw-wenkai-web@latest/style.css" />

		<!-- Basic Meta Tags -->
		<meta name="description" content={description} />
		<meta name="author" content="Rito-492" />
		<link rel="canonical" href={siteUrl + Astro.url.pathname} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={siteUrl + Astro.url.pathname} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="zh_CN" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>
	</head>
	<body>
		<Header title="Rito-492's Blog" />

		<!-- 首页布局：左侧 Sidebar + 中间内容 -->
		{isHomePage ? (
			<div class="layout-container home-layout">
				<aside class="sidebar-column">
					<div class="profile-card">
						<div class="avatar">
							<img src="/avatar.jpg" alt="avatar" />
						</div>
						<h2 class="name">Rito-492</h2>
						<p class="bio">世界很大，开心第一。</p>
						<div class="social-links">
							<a href="mailto:richardtowne8284@gmail.com" class="social-link">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect width="20" height="16" x="2" y="4" rx="2"/>
									<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
								</svg>
								Email
							</a>
							<a href="https://github.com/Rito-492" target="_blank" rel="noopener noreferrer" class="social-link">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
								</svg>
								GitHub
							</a>
							<a href="https://steamcommunity.com/profiles/76561199226205480/" target="_blank" rel="noopener noreferrer" class="social-link">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
									<path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/>
								</svg>
								Steam
							</a>
						</div>
					</div>
				</aside>
				<main class="main-content">
					<div class="scroll-progress" id="scrollProgress"></div>
					<slot />
					<button class="back-to-top" id="backToTop" aria-label="返回顶部">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m18 15-6-6-6 6"/>
						</svg>
					</button>
				</main>
			</div>
		) : (
			<!-- 其他页面：只有中间内容 -->
			{showToc && tocHeadings.length > 0 ? (
				<!-- 博客文章页：文章 + 右侧目录 -->
				<div class="post-layout full-width">
					<main class="main-content">
						<div class="scroll-progress" id="scrollProgress"></div>
						<slot />
						<button class="back-to-top" id="backToTop" aria-label="返回顶部">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="m18 15-6-6-6 6"/>
							</svg>
						</button>
					</main>
					<aside class="toc-sidebar">
							{series && (
								<div class="toc-series">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
									</svg>
									<span>{series}</span>
								</div>
							)}
							{tags.length > 0 && (
								<div class="toc-label">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
									<span>标签</span>
								</div>
								<nav class="toc-tags">
									{tags.map(tag => (
										<a href={`/blog?tag=${encodeURIComponent(tag)}`} class="toc-tag">{tag}</a>
									))}
								</nav>
							)}
							<h3 class="toc-title">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
									<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
								</svg>
								{postTitle || '目录'}
							</h3>
							<nav class="toc-nav" id="tocNav">
							<ul>
								{tocHeadings.filter(h => h.depth >= 2 && h.depth <= 3).map((heading) => (
									<li class={`toc-item depth-${heading.depth}`}>
										<a href={`#${heading.id}`}>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</aside>
				</div>
			) : isBlogListPage ? (
					<slot />
				) : (
				<main class="main-content full-width">
					<div class="scroll-progress" id="scrollProgress"></div>
					<slot />
					<button class="back-to-top" id="backToTop" aria-label="返回顶部">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m18 15-6-6-6 6"/>
						</svg>
					</button>
				</main>
			)}
		)}

		<Footer />

		<!-- 鼠标点击特效容器 -->
		<div id="click-effects"></div>

		<script is:inline>
			// Scroll progress bar
			const scrollProgress = document.getElementById('scrollProgress');
			const backToTopBtn = document.getElementById('backToTop');

			window.addEventListener('scroll', () => {
				const scrollTop = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrollPercent = (scrollTop / docHeight) * 100;
				scrollProgress.style.width = scrollPercent + '%';

				if (scrollTop > 300) {
					backToTopBtn.classList.add('visible');
				} else {
					backToTopBtn.classList.remove('visible');
				}
			});

			backToTopBtn.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// 鼠标点击特效
			const clickEffectsContainer = document.getElementById('click-effects');

			document.addEventListener('click', (e) => {
				if (!clickEffectsContainer) return;

				const ripple = document.createElement('div');
				ripple.className = 'click-ripple';
				ripple.style.left = e.clientX + 'px';
				ripple.style.top = e.clientY + 'px';
				clickEffectsContainer.appendChild(ripple);

				for (let i = 0; i < 8; i++) {
					const particle = document.createElement('div');
					particle.className = 'click-particle';
					particle.style.left = e.clientX + 'px';
					particle.style.top = e.clientY + 'px';

					const angle = (i / 8) * Math.PI * 2;
					const velocity = 30 + Math.random() * 30;
					const tx = Math.cos(angle) * velocity;
					const ty = Math.sin(angle) * velocity;

					particle.style.setProperty('--tx', tx + 'px');
					particle.style.setProperty('--ty', ty + 'px');

					clickEffectsContainer.appendChild(particle);
				}

				setTimeout(() => { ripple.remove(); }, 650);
				setTimeout(() => {
					clickEffectsContainer.querySelectorAll('.click-particle').forEach(p => p.remove());
				}, 550);
			});

			// 博客目录高亮
			const tocNav = document.getElementById('tocNav');
			if (tocNav) {
				const tocLinks = tocNav.querySelectorAll('a');
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							tocLinks.forEach(link => {
								link.classList.remove('active');
								if (link.getAttribute('href') === `#${entry.target.id}`) {
									link.classList.add('active');
								}
							});
						}
					});
				}, { rootMargin: '-100px 0px -60% 0px' });

				document.querySelectorAll('h2, h3').forEach(heading => {
					observer.observe(heading);
				});
			}
		</script>
	</body>
</html>

<style>
	/* 首页布局：左侧 Sidebar + 中间内容 */
	.home-layout {
		display: grid;
		grid-template-columns: 1fr 720px 1fr;
		padding: 2rem 0;
		position: relative;
	}

	.sidebar-column {
		grid-column: 1;
		justify-self: end;
		margin-right: 2.5rem;
		width: 200px;
		position: sticky;
		top: 5rem;
		height: fit-content;
	}

	.main-content {
		grid-column: 2;
		min-width: 0;
	}

	.profile-card {
		padding: 0;
		text-align: left;
	}

	.avatar {
		width: 64px;
		height: 64px;
		margin: 0 0 1rem;
		border-radius: 50%;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.35rem;
	}

	.bio {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin-bottom: 1.5rem;
		line-height: 1.6;
	}

	.social-links {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		align-items: flex-start;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		transition: all 0.2s;
		padding: 0.4rem 0.6rem;
		border-radius: 8px;
		line-height: 1.4;
	}

	.social-link svg {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	.social-link:hover {
		color: var(--color-primary);
		background: rgba(8, 145, 178, 0.06);
	}

	/* 通用内容区 */
	.main-content {
		min-width: 0;
	}

	.full-width {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem;
	}

	/* 博客文章页布局：文章 + 右侧目录 */
	.post-layout {
		display: grid;
		grid-template-columns: 1fr 680px 1fr;
		padding: 2rem 0;
	}

	.post-layout.full-width {
		padding: 2rem 0;
	}

	.post-layout .main-content {
		grid-column: 2;
		min-width: 0;
		padding: 0;
	}

	/* 博客目录 TOC */
	.toc-sidebar {
		grid-column: 3;
		width: 100%;
		box-sizing: border-box;
		margin-left: 2.5rem;
		position: sticky;
		top: 5rem;
		height: fit-content;
		max-height: calc(100vh - 7rem);
		overflow-y: auto;
		padding: 1.25rem 0;
		border-left: 1px solid var(--color-border);
	}


	/* 系列名称 */
	.toc-series {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		padding-left: 0.25rem;
	}

	.toc-series svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	/* 标签标题 - 与系列名统一 */
	.toc-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		padding-left: 0.25rem;
	}

	.toc-label svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	/* 目录标题 - 统一样式 */
	.toc-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		padding-left: 0.25rem;
	}

	.toc-title svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	/* 目录导航 */
	.toc-nav ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-item {
		margin-bottom: 0.4rem;
	}

	.toc-item a {
		display: block;
		padding: 0.35rem 0.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		line-height: 1.5;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: all 0.2s;
		border-left: 2px solid transparent;
	}

	.toc-item a:hover {
		color: var(--color-text);
		border-left-color: var(--color-primary);
	}

	.toc-item a.active {
		color: var(--color-primary);
		border-left-color: var(--color-primary);
		font-weight: 500;
	}

	.toc-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 1.25rem;
		padding-left: 0.5rem;
	}
		.toc-tag {
			font-size: 0.78rem;
			color: var(--color-text-muted);
			text-decoration: none;
			transition: color 0.15s;
			white-space: nowrap;
		}
		.toc-tag:hover {
			color: var(--color-primary);
		}

	.toc-item.depth-3 a {
		padding-left: 1.25rem;
		font-size: 0.8rem;
	}

	/* Back to top */
	.back-to-top {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 50px;
		height: 50px;
		border-radius: 50%;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		box-shadow: 0 4px 12px var(--color-shadow);
		color: var(--color-primary);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		visibility: hidden;
		transform: translateY(20px);
		transition: all 0.3s;
		z-index: 99;
	}

	.back-to-top.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.back-to-top:hover {
		background: var(--color-primary);
		color: white;
		box-shadow: 0 6px 20px rgba(8, 145, 178, 0.4);
		transform: translateY(-4px);
	}

	.scroll-progress {
		position: fixed;
		top: 0;
		left: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-primary-hover));
		width: 0%;
		z-index: 1000;
		transition: width 0.1s;
	}


	/* 响应式 */
	@media (max-width: 1150px) {
		.home-layout {
			grid-template-columns: 1fr;
			padding: 2rem 1rem;
		}

		.sidebar-column {
			display: none;
		}

		.post-layout {
			grid-template-columns: 1fr;
			padding: 2rem 1rem;
		}

		.toc-sidebar {
			display: none;
		}

		.full-width {
			padding: 1rem;
		}
	}
</style>
