---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import ProfileCard from '../components/ProfileCard.astro';
import TocSidebar from '../components/TocSidebar.astro';
import MobileToc from '../components/MobileToc.astro';
import ContentShell from '../components/ContentShell.astro';
import { SITE } from '../config';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/layouts.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	jsonLd?: Record<string, unknown>;
	showToc?: boolean;
	tocHeadings?: Array<{ depth: number; text: string; id: string }>;
	series?: string;
	postTitle?: string;
	tags?: string[];
}

const {
	title,
	description = SITE.description,
	image = '/og-image.png',
	type = 'website',
	jsonLd,
	showToc = false,
	tocHeadings = [],
	series = '',
	postTitle = '',
	tags = [],
} = Astro.props;

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const isBlogListPage = Astro.url.pathname.replace(/\/$/, '') === '/blog';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<SeoHead
			title={title}
			description={description}
			image={image}
			type={type}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header title={SITE.title} />

		{isHomePage ? (
			<div class="layout-container home-layout">
				<aside class="sidebar-column">
					<ProfileCard />
				</aside>
				<ContentShell>
					<slot />
				</ContentShell>
			</div>
		) : showToc && tocHeadings.length > 0 ? (
			<div class="post-layout full-width">
				<ContentShell>
					<slot />
				</ContentShell>
				<TocSidebar
					series={series}
					postTitle={postTitle}
					tags={tags}
					tocHeadings={tocHeadings}
				/>
				<MobileToc tocHeadings={tocHeadings} />
			</div>
		) : isBlogListPage ? (
			<slot />
		) : (
			<ContentShell fullWidth={true}>
				<slot />
			</ContentShell>
		)}

		<Footer />

		<!-- 鼠标点击特效容器 -->
		<div id="click-effects"></div>

		<script is:inline>
			// Scroll progress bar（博客列表页没有这些元素，需判空）
			const scrollProgress = document.getElementById('scrollProgress');
			const backToTopBtn = document.getElementById('backToTop');

			if (scrollProgress && backToTopBtn) {
				window.addEventListener('scroll', () => {
					const scrollTop = window.scrollY;
					const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
					const scrollPercent = (scrollTop / docHeight) * 100;
					scrollProgress.style.width = scrollPercent + '%';

					if (scrollTop > 300) {
						backToTopBtn.classList.add('visible');
					} else {
						backToTopBtn.classList.remove('visible');
					}
				});

				backToTopBtn.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}

			// 鼠标点击特效
			const clickEffectsContainer = document.getElementById('click-effects');

			document.addEventListener('click', (e) => {
				if (!clickEffectsContainer) return;

				const ripple = document.createElement('div');
				ripple.className = 'click-ripple';
				ripple.style.left = e.clientX + 'px';
				ripple.style.top = e.clientY + 'px';
				clickEffectsContainer.appendChild(ripple);

				for (let i = 0; i < 8; i++) {
					const particle = document.createElement('div');
					particle.className = 'click-particle';
					particle.style.left = e.clientX + 'px';
					particle.style.top = e.clientY + 'px';

					const angle = (i / 8) * Math.PI * 2;
					const velocity = 30 + Math.random() * 30;
					const tx = Math.cos(angle) * velocity;
					const ty = Math.sin(angle) * velocity;

					particle.style.setProperty('--tx', tx + 'px');
					particle.style.setProperty('--ty', ty + 'px');

					clickEffectsContainer.appendChild(particle);
				}

				setTimeout(() => { ripple.remove(); }, 650);
				setTimeout(() => {
					clickEffectsContainer.querySelectorAll('.click-particle').forEach(p => p.remove());
				}, 550);
			});

			// 博客目录高亮
			const tocNav = document.getElementById('tocNav');
			if (tocNav) {
				const tocLinks = tocNav.querySelectorAll('a');
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							tocLinks.forEach(link => {
								link.classList.remove('active');
								if (link.getAttribute('href') === `#${entry.target.id}`) {
									link.classList.add('active');
								}
							});
						}
					});
				}, { rootMargin: '-100px 0px -60% 0px' });

				document.querySelectorAll('h2, h3').forEach(heading => {
					observer.observe(heading);
				});
			}
		</script>
	</body>
</html>
