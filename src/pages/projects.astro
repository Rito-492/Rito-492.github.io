---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: '项目名称 1',
		description: '这是一个示例项目描述。简要说明项目的功能和技术栈。',
		tech: ['React', 'TypeScript', 'Node.js'],
		link: '#',
		github: '#',
	},
	{
		title: '项目名称 2',
		description: '另一个有趣的项目。描述它解决了什么问题，有什么特点。',
		tech: ['Vue', 'Python', 'PostgreSQL'],
		link: '#',
		github: '#',
	},
	{
		title: '项目名称 3',
		description: '这是一个技术实验项目。探索了某些新技术或解决方案。',
		tech: ['Go', 'Docker', 'Redis'],
		link: '#',
		github: '#',
	},
];
---

<Layout title="项目作品 - Rito">
	<section class="projects-header">
		<h1>项目作品</h1>
		<p>这里展示了我的一些个人项目和作品</p>
	</section>

	<section class="projects-grid">
		{projects.map((project) => (
			<article class="project-card">
				<h3>{project.title}</h3>
				<p>{project.description}</p>
				<div class="tech-stack">
					{project.tech.map((tech) => (
						<span class="tech-tag">{tech}</span>
					))}
				</div>
				<div class="project-links">
					{project.link !== '#' && (
						<a href={project.link} class="link" target="_blank" rel="noopener noreferrer">
							在线演示 →
						</a>
					)}
					{project.github !== '#' && (
						<a href={project.github} class="link" target="_blank" rel="noopener noreferrer">
							GitHub
						</a>
					)}
				</div>
			</article>
		))}
	</section>
</Layout>

<style>
	.projects-header {
		text-align: center;
		padding: 2rem 0 3rem;
	}

	.projects-header h1 {
		margin-bottom: 0.5rem;
	}

	.projects-header p {
		color: var(--color-text-muted);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	.project-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.5rem;
		transition: border-color 0.2s;
	}

	.project-card:hover {
		border-color: var(--color-primary);
	}

	.project-card h3 {
		margin-bottom: 0.75rem;
		color: var(--color-text);
	}

	.project-card p {
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.tech-tag {
		background: rgba(56, 189, 248, 0.1);
		color: var(--color-primary);
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.875rem;
	}

	.project-links {
		display: flex;
		gap: 1rem;
	}

	.project-links a {
		color: var(--color-primary);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.project-links a:hover {
		text-decoration: underline;
	}
</style>
