---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => {
	return !data.draft;
});

const sortedProjects = projects.sort((a, b) => {
	return a.id.localeCompare(b.id);
});
---

<Layout title="项目作品 - Rito">
	<section class="projects-header">
		<div class="header-content">
			<span class="header-icon">🚀</span>
			<h1>项目作品</h1>
			<p>这里展示了我的一些个人项目和作品</p>
		</div>
	</section>

	<section class="projects-grid">
		{sortedProjects.length === 0 ? (
			<div class="empty-state">
				<span class="empty-icon">🌱</span>
				<p class="no-projects">还没有项目，敬请期待！</p>
			</div>
		) : (
			sortedProjects.map((project) => (
				<article class="project-card">
					<div class="card-icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 19V5"/>
							<path d="m5 12 7 7 7-7"/>
						</svg>
					</div>
					<h3>{project.data.title}</h3>
					<p>{project.data.description}</p>
					<div class="tech-stack">
						{project.data.tech.map((tech) => (
							<span class="tech-tag">{tech}</span>
						))}
					</div>
					<div class="project-links">
						{project.data.github && (
							<a href={project.data.github} target="_blank" rel="noopener noreferrer" class="link github">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
								</svg>
								<span>代码</span>
							</a>
						)}
						{project.data.link && (
							<a href={project.data.link} target="_blank" rel="noopener noreferrer" class="link demo">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
									<polyline points="15 3 21 3 21 9"/>
									<line x1="10" x2="21" y1="14" y2="3"/>
								</svg>
								<span>演示</span>
							</a>
						)}
					</div>
				</article>
			))
		)}
	</section>
</Layout>

<style>
	.projects-header {
		text-align: center;
		padding: 3rem 0 4rem;
	}

	.header-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.header-icon {
		font-size: 3rem;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.projects-header h1 {
		margin-bottom: 0.5rem;
		position: relative;
	}

	.projects-header h1::after {
		content: '';
		position: absolute;
		bottom: -8px;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 3px;
		background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
		border-radius: 2px;
	}

	.projects-header p {
		color: var(--color-text-muted);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.empty-state {
		grid-column: 1 / -1;
		text-align: center;
		padding: 4rem 2rem;
	}

	.empty-icon {
		font-size: 4rem;
		display: block;
		margin-bottom: 1rem;
	}

	.no-projects {
		color: var(--color-text-muted);
		font-size: 1.1rem;
	}

	.project-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.5rem;
		transition: all 0.3s;
		box-shadow: 0 2px 8px var(--color-shadow);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.project-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-primary-hover));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s;
	}

	.project-card:hover::before {
		transform: scaleX(1);
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 32px rgba(37, 99, 235, 0.15);
		border-color: var(--color-primary);
	}

	.card-icon {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(29, 78, 216, 0.15));
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
		margin-bottom: 1rem;
	}

	.project-card h3 {
		margin-bottom: 0.75rem;
		color: var(--color-text);
		font-size: 1.25rem;
	}

	.project-card p {
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: 1rem;
		flex: 1;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}

	.tech-tag {
		background: rgba(37, 99, 235, 0.1);
		color: var(--color-primary);
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 500;
		transition: all 0.2s;
	}

	.tech-tag:hover {
		background: rgba(37, 99, 235, 0.2);
		transform: translateY(-1px);
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		margin-top: auto;
	}

	.project-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		padding: 0.6rem 1rem;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		transition: all 0.2s;
	}

	.project-links a:hover {
		border-color: var(--color-primary);
		background: rgba(37, 99, 235, 0.05);
		transform: translateY(-2px);
	}

	.project-links .github:hover {
		background: rgba(37, 99, 235, 0.1);
	}

	.project-links .demo:hover {
		background: rgba(37, 99, 235, 0.1);
	}

	@media (max-width: 640px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}

		.project-links {
			flex-direction: column;
		}

		.project-links a {
			justify-content: center;
		}
	}
</style>
