---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => {
	return !data.draft;
});

const sortedProjects = projects.sort((a, b) => {
	return a.id.localeCompare(b.id);
});
---

<Layout title="Projects - Rito-492">
	<section class="projects-header">
		<div class="header-content">
			<span class="header-icon">🚀</span>
			<h1>项目作品</h1>
			<p>这里展示了我的一些个人项目和作品</p>
		</div>
	</section>

	<section class="projects-grid">
		{sortedProjects.length === 0 ? (
			<div class="empty-state">
				<span class="empty-icon">🌱</span>
				<p class="no-projects">还没有项目，敬请期待！</p>
			</div>
		) : (
			sortedProjects.map((project) => (
				<a href={project.data.github} target="_blank" rel="noopener noreferrer" class="project-card">
					<div class="card-icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 19V5"/>
							<path d="m5 12 7 7 7-7"/>
						</svg>
					</div>
					<h3>{project.data.title}</h3>
					<p>{project.data.description}</p>
					<div class="tech-stack">
						{project.data.tech.map((tech) => (
							<span class="tech-tag">{tech}</span>
						))}
					</div>
				</a>
			))
		)}
	</section>
</Layout>

<style>
	.projects-header {
		text-align: center;
		padding: 3rem 0 4rem;
	}

	.header-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.header-icon {
		font-size: 3rem;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.projects-header h1 {
		margin-bottom: 0.5rem;
		position: relative;
	}

	.projects-header h1::after {
		content: '';
		position: absolute;
		bottom: -8px;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 3px;
		background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
		border-radius: 2px;
	}

	.projects-header p {
		color: var(--color-text-muted);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.empty-state {
		grid-column: 1 / -1;
		text-align: center;
		padding: 4rem 2rem;
	}

	.empty-icon {
		font-size: 4rem;
		display: block;
		margin-bottom: 1rem;
	}

	.no-projects {
		color: var(--color-text-muted);
		font-size: 1.1rem;
	}

	.project-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.5rem;
		transition: all 0.3s;
		box-shadow: 0 2px 8px var(--color-shadow);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		text-decoration: none;
	}

	.project-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-primary-hover));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s;
	}

	.project-card:hover::before {
		transform: scaleX(1);
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 32px rgba(8, 145, 178, 0.15);
		border-color: var(--color-primary);
	}

	.card-icon {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: linear-gradient(135deg, rgba(8, 145, 178, 0.1), rgba(14, 116, 144, 0.15));
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
		margin-bottom: 1rem;
	}

	.project-card h3 {
		margin-bottom: 0.75rem;
		color: var(--color-text);
		font-size: 1.25rem;
	}

	.project-card p {
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: 1rem;
		flex: 1;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}

	.tech-tag {
		background: rgba(8, 145, 178, 0.1);
		color: var(--color-primary);
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 500;
		transition: all 0.2s;
	}

	.tech-tag:hover {
		background: rgba(8, 145, 178, 0.2);
		transform: translateY(-1px);
	}



</style>
