---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<Layout title="About - Rito-492">
	<section class="about-section">
		<header class="about-header">
			<div class="avatar">
				<img src="/avatar.jpg" alt="avatar" />
			</div>
			<h1>Rito-492</h1>
			<p class="subtitle">世界很大，开心第一。</p>
		</header>

		<div class="about-content">
			<div class="card intro">
				<h2>关于我</h2>
				<p>你好，我是 Rito-492，目前是吉林大学2023级本科生。</p>
				<p>
					我想用这个网站来分享我自己的一些想法、感悟和一些折腾的记录。 网站基于 Astro
					构建，部署在 GitHub Pages 上。
				</p>
			</div>

			<div class="card toolbox">
				<h2>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
					</svg>
					工具箱
				</h2>
				<div class="tools-grid">
					<div class="tool-group">
						<span class="tool-label">主力语言</span>
						<div class="tool-tags">
							<span class="tool-tag">Python</span>
							<span class="tool-tag">C++</span>
							<span class="tool-tag">Java</span>
						</div>
					</div>
					<div class="tool-group">
						<span class="tool-label">深度学习</span>
						<div class="tool-tags">
							<span class="tool-tag">PyTorch</span>
							<span class="tool-tag">KAN</span>
							<span class="tool-tag">Diffusion</span>
						</div>
					</div>
					<div class="tool-group">
						<span class="tool-label">工具</span>
						<div class="tool-tags">
							<span class="tool-tag">Linux</span>
							<span class="tool-tag">WSL2</span>
							<span class="tool-tag">Arch</span>
							<span class="tool-tag">Git</span>
							<span class="tool-tag">Docker</span>
						</div>
					</div>
				</div>
			</div>

			<div class="card connect">
				<h2>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
						<polyline points="22,6 12,13 2,6" />
					</svg>
					找到我
				</h2>
				<SocialLinks variant="row" ids={['github', 'email', 'steam']} />
			</div>
		</div>
	</section>
</Layout>

<style>
	.about-section {
		max-width: none;
		margin: 0;
		padding: 2rem;
	}

	/* Header */
	.about-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.about-header .avatar {
		width: 80px;
		height: 80px;
		margin: 0 auto 1rem;
		border-radius: 50%;
		overflow: hidden;
	}

	.about-header .avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		image-rendering: -webkit-optimize-contrast;
	}

	main.full-width {
		max-width: none !important;
		padding: 0 !important;
	}

	.about-header h1 {
		font-size: 1.75rem;
		font-weight: 700;
		margin: 0 0 0.35rem;
	}

	.about-header .subtitle {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin: 0;
	}

	/* Content */
	.about-content {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 780px;
		margin: 0 auto;
	}

	.card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.5rem;
		transition: all 0.2s;
	}

	.card:hover {
		border-color: rgba(8, 145, 178, 0.3);
		box-shadow: 0 4px 16px rgba(8, 145, 178, 0.08);
	}

	.card h2 {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.card h2 svg {
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.intro p {
		color: var(--color-text-muted);
		line-height: 1.8;
		margin: 0 0 1rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	/* Toolbox */
	.tools-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.tool-group {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.tool-label {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text-muted);
		min-width: 70px;
		flex-shrink: 0;
	}

	.tool-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tool-tag {
		background: rgba(8, 145, 178, 0.08);
		color: var(--color-primary);
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		font-size: 0.78rem;
		font-weight: 500;
		transition: all 0.2s;
		border: 1px solid transparent;
	}

	.tool-tag:hover {
		background: rgba(8, 145, 178, 0.15);
		border-color: var(--color-primary);
		transform: translateY(-1px);
	}

	/* Responsive */
	@media (max-width: 640px) {
		.about-section {
			padding: 2rem 1rem;
		}

		.about-header h1 {
			font-size: 1.5rem;
		}

		.tool-group {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
