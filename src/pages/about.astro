		filled: false,
		svg: '<polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/>',
	},
	{
		name: 'Lucide',
		cat: 'Icons',
		href: 'https://lucide.dev',
		filled: true,
		svg: '<path d="M18.483 1.123a1.09 1.09 0 0 0-.752.362 1.09 1.09 0 0 0 .088 1.54 11.956 11.956 0 0 1 4 8.946 7.62 7.62 0 0 1-7.637 7.636 7.62 7.62 0 0 1-7.637-7.636 3.255 3.255 0 0 1 3.273-3.273c1.82 0 3.273 1.45 3.273 3.273a1.09 1.09 0 0 0 1.09 1.09 1.09 1.09 0 0 0 1.092-1.09c0-3-2.455-5.455-5.455-5.455s-5.454 2.455-5.454 5.455c0 5.408 4.408 9.818 9.818 9.818 5.41 0 9.818-4.41 9.818-9.818A14.16 14.16 0 0 0 19.272 1.4a1.09 1.09 0 0 0-.789-.277ZM9.818 2.15C4.408 2.151 0 6.561 0 11.97a14.16 14.16 0 0 0 4.8 10.637 1.09 1.09 0 0 0 1.54-.096 1.09 1.09 0 0 0-.095-1.54 11.957 11.957 0 0 1-4.063-9 7.62 7.62 0 0 1 7.636-7.637 7.62 7.62 0 0 1 7.637 7.636 3.256 3.256 0 0 1-3.273 3.273 3.256 3.256 0 0 1-3.273-3.273 1.09 1.09 0 0 0-1.09-1.09 1.09 1.09 0 0 0-1.092 1.09c0 3 2.455 5.455 5.455 5.455s5.454-2.455 5.454-5.455c0-5.408-4.408-9.818-9.818-9.818z"/>',
	},
	{
		name: 'Simple Icons',
		cat: 'Brand Icons',
		href: 'https://simpleicons.org',
		filled: true,
		svg: '<path d="M18 6a6 6 0 10-6 6 6 6 0 015.35 9h1.5A7.5 7.5 0 0012 10.5 4.5 4.5 0 1116.5 6Zm-6-3a3 3 0 000 6 1 1 0 000-6m0 1.5a1.5 1.5 0 010 3 1 1 0 010-3M7.5 15v1.5H9v6H4.5V24h15v-1.5H15v-6h1.5V15Zm3 1.5h3v6h-3zm-6 1.5a7.5 7.5 0 00.7 3h1.5a6 6 0 01-.7-3Z"/>',
	},
	{
		name: 'CC BY-NC-SA 4.0',
		cat: 'License',
		href: LICENSE.deedUrl,
		filled: true,
		svg: '<path d="M11.983 0c-3.292 0-6.19 1.217-8.428 3.485C1.25 5.819 0 8.844 0 12c0 3.189 1.217 6.148 3.522 8.45C5.827 22.75 8.822 24 11.983 24c3.16 0 6.222-1.25 8.593-3.583C22.815 18.214 24 15.287 24 12c0-3.255-1.186-6.214-3.458-8.483C18.238 1.217 15.275 0 11.983 0zm.033 2.17c2.7 0 5.103 1.02 6.98 2.893 1.843 1.841 2.83 4.274 2.83 6.937 0 2.696-.954 5.063-2.798 6.872-1.943 1.906-4.444 2.926-7.012 2.926-2.601 0-5.038-1.019-6.914-2.893-1.877-1.875-2.93-4.34-2.93-6.905 0-2.597 1.053-5.063 2.93-6.97 1.844-1.874 4.214-2.86 6.914-2.86zM8.68 8.278C6.723 8.278 5.165 9.66 5.165 12c0 2.38 1.465 3.722 3.581 3.722 1.358 0 2.516-.744 3.155-1.874l-1.491-.758c-.333.798-.839 1.037-1.478 1.037-1.105 0-1.61-.917-1.61-2.126 0-1.21.426-2.127 1.61-2.127.32 0 .96.173 1.332.97l1.597-.838c-.68-1.236-1.837-1.728-3.181-1.728zm6.932 0c-1.957 0-3.514 1.382-3.514 3.722 0 2.38 1.464 3.722 3.58 3.722 1.359 0 2.516-.744 3.155-1.874l-1.49-.758c-.333.798-.84 1.037-1.478 1.037-1.105 0-1.611-.917-1.611-2.126 0-1.21.426-2.127 1.61-2.127.32 0 .96.173 1.332.97l1.597-.838c-.68-1.236-1.837-1.728-3.181-1.728z"/>',
	},
	{ name: 'GitHub', cat: 'Source Code', href: SITE.repo, filled: true, svg: GITHUB_MARK },
];

const tocHeadings = [
	{ depth: 2, text: 'About Me', id: 'about-me' },
	{ depth: 2, text: 'What I Write', id: 'writing' },
	{ depth: 2, text: 'Site Stats', id: 'stats' },
	{ depth: 2, text: 'Toolbox', id: 'toolbox' },
	{ depth: 2, text: 'About This Site', id: 'site' },
	{ depth: 2, text: 'Copyright', id: 'copyright' },
	{ depth: 2, text: 'Privacy', id: 'privacy' },
];
---

<Layout title="About - Rito-492">
	<!-- 文章式排版为底，结构化内容（统计/清单/Colophon）做成轻组件穿插其中 -->
	<article class="about-content">
		<header class="about-header">
			<h1>About</h1>
			<p class="subtitle">A bit about me, this site, and how things work here.</p>
		</header>

		<section class="about-section">
			<h2 id="about-me">About Me</h2>
			<p>你好，我是 Rito-492，吉林大学 2023 级本科生，软件工程专业。</p>
			<p>
				平时主要写 Python 和 C++，折腾深度学习、Linux
				和各类工具；也会把保研、夏令营这类经历整理成文字。
			</p>
			<p>这个博客是代码与思考的自留地——把学过的东西写清楚，把没想明白的事情慢慢想明白。</p>
		</section>

		<section class="about-section">
			<h2 id="writing">What I Write</h2>
			<p>这里的内容大致三类：</p>
			<ul class="topic-list">
				<li>
					<Icon name="code" size={15} />
					<span>
						<strong>技术笔记</strong>——深度学习、Python / C++、Linux 工具链的学与用；
					</span>
				</li>
				<li>
					<Icon name="sprout" size={15} />
					<span>
						<strong>经验分享</strong>——保研、夏令营这类过程的复盘与记录；
					</span>
				</li>
				<li>
					<Icon name="wrench" size={15} />
					<span>
						<strong>折腾记录</strong>——建站、工具配置与效率流的实践。
					</span>
				</li>
			</ul>
		</section>

		<section class="about-section">
			<h2 id="stats">Site Stats</h2>
			<div class="stats-row">
				<div class="stat">
					<span class="stat-num">{postCount}</span>
					<span class="stat-label">Articles</span>
				</div>
				<div class="stat">
					<span class="stat-num">{daysRunning}</span>
					<span class="stat-label">Days Running</span>
				</div>
				<div class="stat">
					<span class="stat-num" data-stat-views>
						—
					</span>
					<span class="stat-label">Total Views</span>
				</div>
			</div>
			<p class="stats-note">
				文章数为已发布篇数；运行天数自首篇文章起算；总浏览量由 GoatCounter
				按全站页面浏览聚合统计。
			</p>
		</section>

		<section class="about-section">
			<h2 id="toolbox">Toolbox</h2>
			<div class="tools-grid">
				<div class="tool-group">
					<span class="tool-label">Languages</span>
					<div class="tool-tags">
						<span class="tech-tag">Python</span>
						<span class="tech-tag">C++</span>
						<span class="tech-tag">Java</span>
					</div>
				</div>
				<div class="tool-group">
					<span class="tool-label">Deep Learning</span>
					<div class="tool-tags">
						<span class="tech-tag">PyTorch</span>
						<span class="tech-tag">KAN</span>
						<span class="tech-tag">Diffusion</span>
					</div>
				</div>
				<div class="tool-group">
					<span class="tool-label">Tools</span>
					<div class="tool-tags">
						<span class="tech-tag">Linux</span>
						<span class="tech-tag">WSL2</span>
						<span class="tech-tag">Arch</span>
						<span class="tech-tag">Git</span>
						<span class="tech-tag">Docker</span>
					</div>
				</div>
			</div>
		</section>

		<section class="about-section">
			<h2 id="site">About This Site</h2>
			<p>本站是一个纯静态网站，设计与源码全部开源。技术选型与素材来源如下：</p>
			<div class="site-cards">
				{siteStack.map((item) => (
					<a class="site-card" href={item.href} target="_blank" rel="noopener noreferrer">
						<span class="site-card-icon" aria-hidden="true">
							<svg
								viewBox="0 0 24 24"
								fill={item.filled ? 'currentColor' : 'none'}
								stroke={item.filled ? 'none' : 'currentColor'}
								stroke-width={item.filled ? undefined : 2}
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={item.svg}
							/>
						</span>
						<span class="site-card-text">
							<span class="site-card-name">{item.name}</span>
							<span class="site-card-cat">{item.cat}</span>
						</span>
					</a>
				))}
			</div>
		</section>

		<section class="about-section">
			<h2 id="copyright">Copyright</h2>
			<p>
				本站原创文字与设计，除特别注明外，均采用
				<a
					class="text-link"
					href={LICENSE.deedUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					{LICENSE.name}
				</a>
				国际许可协议授权。
			</p>
			<p>您可以自由复制、分享，并基于本站内容进行创作，但须遵守以下条件：</p>
			<ul class="license-list">
				<li>
					<strong>署名</strong>：注明作者 Rito-492 及原文链接；
				</li>
				<li>
					<strong>非商业性使用</strong>：不得将内容用于商业目的；
				</li>
				<li>
					<strong>相同方式共享</strong>：改编作品须以相同协议发布。
				</li>
			</ul>
			<p>
				站内引用的第三方图片、商标与素材，版权归各自权利人所有；如存在侵权内容，请通过
				<a class="text-link" href={email}>
					Email
				</a>
				联系删除。商业转载或批量使用请先联系作者。
			</p>
		</section>

		<section class="about-section">
			<h2 id="privacy">Privacy</h2>
			<p>
				本站使用 GoatCounter
				进行访问统计，仅记录聚合数据（页面路径、来源、浏览器与地区），不设置跟踪
				Cookie，也不采集个人身份信息。文章页显示的浏览数与访问人数就是这份按路径聚合的计数，与访客个人无关。
			</p>
			<p>
				评论区由 Giscus 提供，需要 GitHub 账号登录；评论内容存储在该仓库的 GitHub
				Discussions 中，并遵循 GitHub 的隐私政策。
			</p>
		</section>
	</article>

	<!-- 右栏：本页目录 -->
	<Fragment slot="right">
		<TocSidebar postTitle="Contents" tocHeadings={tocHeadings} />
	</Fragment>
</Layout>

<script>
	import { GOATCOUNTER } from '../config';

	// 站点总浏览量（GoatCounter TOTAL；服务端最长缓存 4 小时，失败保持占位 "—"）
	function initStatViews() {
		const el = document.querySelector<HTMLElement>('[data-stat-views]');
		if (!el || el.dataset.done === '1') return;
		el.dataset.done = '1';
		fetch(`https://${GOATCOUNTER.code}.goatcounter.com/counter/TOTAL.json`)
			.then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
			.then((data) => {
				if (typeof data.count === 'string') el.textContent = data.count;
			})
			.catch(() => {
				// 统计服务不可用时保持显示 "—"
			});
	}

	document.addEventListener('astro:page-load', initStatViews);
</script>

<style>
	/* About 采用文章式排版：无卡片边框，靠标题层级与段间距组织内容 */
	.about-header {
		margin-bottom: 2.5rem;
	}

	.about-header h1 {
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem;
	}

	.about-header .subtitle {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		margin: 0;
	}

	.about-section + .about-section {
		margin-top: 3rem;
	}

	.about-section h2 {
		font-size: 1.35rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 1rem;
		scroll-margin-top: 5rem;
	}

	.about-section p {
		color: var(--color-text);
		line-height: 1.85;
		margin: 0 0 1rem;
	}

	.about-section p:last-child {
		margin-bottom: 0;
	}

	/* 内容导览：图标 + 短句的主题清单 */
	.topic-list {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
	}

	.topic-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		margin-bottom: 0.5rem;
		line-height: 1.85;
	}

	.topic-list li:last-child {
		margin-bottom: 0;
	}

	.topic-list svg {
		flex-shrink: 0;
		margin-top: 0.42rem;
		color: var(--color-primary);
	}

	.topic-list strong {
		font-weight: 600;
	}

	/* 站点数据：大数字行，上下细线区隔，保持文章式的呼吸感 */
	.stats-row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin: 1.25rem 0 1rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.stat-num {
		font-family: var(--font-mono);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--color-text);
	}

	.stat-label {
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.stats-note {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.tools-grid {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.tool-group {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.tool-label {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text-muted);
		min-width: 90px;
		flex-shrink: 0;
	}

	.tool-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	/* Colophon：品牌图标卡（普通图标 lucide / 品牌图标 simple-icons），外框面板 + 双列网格 */
	.site-cards {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.35rem;
		margin-top: 1rem;
		padding: 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.site-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		text-decoration: none;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast);
	}

	.site-card:hover {
		background: rgba(var(--color-primary-rgb), 0.05);
		border-color: var(--color-border);
		text-decoration: none;
	}

	.site-card-icon {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-md);
		background: rgba(var(--color-primary-rgb), 0.09);
		color: var(--color-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.site-card-icon svg {
		width: 18px;
		height: 18px;
