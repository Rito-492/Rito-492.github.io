</Layout>

<style>
	.about-section {
		max-width: none;
		margin: 0;
		padding: 2rem;
	}

	/* Header */
	.about-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.about-header .avatar {
		width: 80px;
		height: 80px;
		margin: 0 auto 1rem;
		border-radius: 50%;
		overflow: hidden;
	}

	.about-header .avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		image-rendering: -webkit-optimize-contrast;
	}

	main.full-width {
		max-width: none !important;
		padding: 0 !important;
	}

	.about-header h1 {
		font-size: 1.75rem;
		font-weight: 700;
		margin: 0 0 0.35rem;
	}

	.about-header .subtitle {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin: 0;
	}

	/* Content */
	.about-content {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 780px;
		margin: 0 auto;
	}

	.card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.5rem;
		transition: all 0.2s;
	}

	.card:hover {
		border-color: rgba(8, 145, 178, 0.3);
		box-shadow: 0 4px 16px rgba(8, 145, 178, 0.08);
	}

	.card h2 {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.card h2 svg {
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.intro p {
		color: var(--color-text-muted);
		line-height: 1.8;
		margin: 0 0 1rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	/* Toolbox */
	.tools-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.tool-group {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.tool-label {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text-muted);
		min-width: 70px;
		flex-shrink: 0;
	}

	.tool-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tool-tag {
		background: rgba(8, 145, 178, 0.08);
		color: var(--color-primary);
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		font-size: 0.78rem;
		font-weight: 500;
		transition: all 0.2s;
		border: 1px solid transparent;
	}

	.tool-tag:hover {
		background: rgba(8, 145, 178, 0.15);
		border-color: var(--color-primary);
		transform: translateY(-1px);
	}

	/* Social links */
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.88rem;
		transition: all 0.2s;
		padding: 0.4rem 0.7rem;
		border-radius: 8px;
	}

	.social-link svg {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	.social-link:hover {
		color: var(--color-primary);
		background: rgba(8, 145, 178, 0.06);
		text-decoration: none;
	}

	/* Responsive */
	@media (max-width: 640px) {
		.about-section {
			padding: 2rem 1rem;
		}

		.about-header h1 {
			font-size: 1.5rem;
		}

		.tool-group {
			flex-direction: column;
			gap: 0.4rem;
		}

		.social-links {
			flex-direction: column;
		}
	}
</style>
