---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import TocSidebar from '../components/TocSidebar.astro';
import { LICENSE, SITE, SOCIALS } from '../config';

const email = SOCIALS.find((s) => s.id === 'email')?.href ?? '';

const posts = await getCollection('blog', ({ data }) => data.isPublished);
const postCount = posts.length;
const firstPostTime = Math.min(...posts.map((p) => p.data.pubDate.getTime()));
const daysRunning = Math.max(1, Math.floor((Date.now() - firstPostTime) / 86400000) + 1);

const GITHUB_MARK =
	'<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 4.348 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>';

const siteStack = [
	{
		name: 'Astro',
		cat: 'Framework',
		href: 'https://astro.build',
		filled: true,
		svg: '<path d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165h.002zm-5.961-4.445s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z"/>',
	},
	{
		name: 'GitHub Pages',
		cat: 'Hosting',
		href: 'https://pages.github.com',
		filled: true,
		svg: GITHUB_MARK,
	},
	{
		name: 'Giscus',
		cat: 'Comments',
		href: 'https://giscus.app',
		filled: false,
		svg: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
	},
	{
		name: 'GoatCounter',
		cat: 'Analytics',
		href: 'https://www.goatcounter.com',
		filled: false,
		svg: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
	},
	{
		name: 'JetBrains Mono',
		cat: 'Font',
		href: 'https://www.jetbrains.com/lp/mono/',
		filled: true,
		svg: '<path d="M2.345 23.997A2.347 2.347 0 0 1 0 21.652V10.988C0 9.665.535 8.37 1.473 7.433l5.965-5.961A5.01 5.01 0 0 1 10.989 0h10.666A2.347 2.347 0 0 1 24 2.345v10.664a5.056 5.056 0 0 1-1.473 3.554l-5.965 5.965A5.017 5.017 0 0 1 13.007 24v-.003H2.345Zm8.969-6.854H5.486v1.371h5.828v-1.371ZM3.963 6.514h13.523v13.519l4.257-4.257a3.936 3.936 0 0 0 1.146-2.767V2.345c0-.678-.552-1.234-1.234-1.234H10.989a3.897 3.897 0 0 0-2.767 1.145L3.963 6.514Zm-.192.192L2.256 8.22a3.944 3.944 0 0 0-1.145 2.768v10.664c0 .678.552 1.234 1.234 1.234h10.666a3.9 3.9 0 0 0 2.767-1.146l1.512-1.511H3.771V6.706Z"/>',
	},
	{
		name: '霞鹜文楷',
		cat: 'Font',
