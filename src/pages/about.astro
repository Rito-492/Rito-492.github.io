---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { LICENSE, SITE } from '../config';
---

<Layout title="About - Rito-492">
	<section class="about-section">
		<header class="about-header">
			<h1>关于</h1>
			<p class="subtitle">关于我、这个网站，以及联系方式。</p>
		</header>

		<div class="about-content">
			<div class="card intro">
				<h2>关于我</h2>
				<p>你好，我是 Rito-492，吉林大学 2023 级本科生，软件工程专业。</p>
				<p>
					平时主要写 Python 和 C++，折腾深度学习、Linux
					和各类工具；也会把保研、夏令营这类经历整理成文字。
				</p>
				<p>
					这个博客是代码与思考的自留地——把学过的东西写清楚，把没想明白的事情慢慢想明白。
				</p>
				<div class="intro-contact">
					<span class="contact-label">找到我</span>
					<SocialLinks variant="row" ids={['github', 'email', 'steam']} />
				</div>
			</div>

			<div class="card toolbox">
				<h2>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
					</svg>
					工具箱
				</h2>
				<div class="tools-grid">
					<div class="tool-group">
						<span class="tool-label">主力语言</span>
						<div class="tool-tags">
							<span class="tech-tag">Python</span>
							<span class="tech-tag">C++</span>
							<span class="tech-tag">Java</span>
						</div>
					</div>
					<div class="tool-group">
						<span class="tool-label">深度学习</span>
						<div class="tool-tags">
							<span class="tech-tag">PyTorch</span>
							<span class="tech-tag">KAN</span>
							<span class="tech-tag">Diffusion</span>
						</div>
					</div>
					<div class="tool-group">
						<span class="tool-label">工具</span>
						<div class="tool-tags">
							<span class="tech-tag">Linux</span>
							<span class="tech-tag">WSL2</span>
							<span class="tech-tag">Arch</span>
							<span class="tech-tag">Git</span>
							<span class="tech-tag">Docker</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 右栏：站点信息 -->
	<Fragment slot="right">
		<aside class="side-panel">
			<div class="side-panel-section">
				<div class="side-panel-title">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect width="20" height="14" x="2" y="3" rx="2" />
						<line x1="8" x2="16" y1="21" y2="21" />
						<line x1="12" x2="12" y1="17" y2="21" />
					</svg>
					<span>这个网站</span>
				</div>
				<p class="side-panel-text">
					本站基于 Astro 构建，以静态方式部署于 GitHub Pages。评论由 Giscus
					提供，访问统计使用 GoatCounter，文章内容采用 {LICENSE.name} 许可协议。
				</p>
				<nav class="side-panel-links">
					<a href={SITE.repo} target="_blank" rel="noopener noreferrer">
						网站源码
					</a>
					<a href="/rss.xml">RSS 订阅</a>
					<a href={LICENSE.deedUrl} target="_blank" rel="noopener noreferrer">
						{LICENSE.name}
					</a>
				</nav>
			</div>
		</aside>
	</Fragment>
</Layout>

<style>
	/* About 独有：居中头像页头 + 卡片内部排版（卡片壳与标签样式在全局 CSS） */
	.about-header {
		margin-bottom: 1.5rem;
		text-align: left;
	}

	.about-header h1 {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.35rem;
	}

	.about-header .subtitle {
		color: var(--color-text-muted);
		font-size: 0.88rem;
		margin: 0;
	}

	.about-content {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.card h2 {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.card h2 svg {
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.intro p {
		color: var(--color-text-muted);
		line-height: 1.8;
		margin: 0 0 1rem;
	}

	.intro p:last-of-type {
		margin-bottom: 0;
	}

	.intro-contact {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.contact-label {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.tools-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.tool-group {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.tool-label {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text-muted);
		min-width: 70px;
		flex-shrink: 0;
	}

	.tool-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	@media (max-width: 640px) {
		.about-header h1 {
			font-size: 1.5rem;
		}

		.tool-group {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
