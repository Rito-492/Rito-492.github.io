---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Rito-492">
	<section class="about-section">
		<header class="about-header">
			<div class="avatar">
				<img src="/avatar.jpg" alt="avatar" />
			</div>
			<h1>Rito-492</h1>
			<p class="subtitle">世界很大，开心第一。</p>
		</header>

		<div class="about-content">
			<div class="card intro">
				<h2>关于我</h2>
				<p>
					你好，我是 Rito-492，目前是吉林大学2023级本科生。
				</p>
				<p>
					我想用这个网站来分享我自己的一些想法、感悟和一些折腾的记录。
					网站基于 Astro 构建，部署在 GitHub Pages 上。
				</p>
			</div>

