					工具箱
				</h2>
				<div class="tools-grid">
					<div class="tool-group">
						<span class="tool-label">主力语言</span>
						<div class="tool-tags">
							<span class="tool-tag">Python</span>
							<span class="tool-tag">C++</span>
							<span class="tool-tag">Java</span>
						</div>
					</div>
					<div class="tool-group">
						<span class="tool-label">深度学习</span>
						<div class="tool-tags">
							<span class="tool-tag">PyTorch</span>
							<span class="tool-tag">KAN</span>
							<span class="tool-tag">Diffusion</span>
						</div>
					</div>
					<div class="tool-group">
						<span class="tool-label">工具</span>
						<div class="tool-tags">
							<span class="tool-tag">Linux</span>
							<span class="tool-tag">WSL2</span>
							<span class="tool-tag">Arch</span>
							<span class="tool-tag">Git</span>
							<span class="tool-tag">Docker</span>
						</div>
					</div>
				</div>
			</div>

