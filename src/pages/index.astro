---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = projects.slice(0, 3);

const posts = await getCollection('blog', ({ data }) => data.isPublished);
const latestPosts = posts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const allSeries = [
	...new Set(posts.filter((p) => p.data.series).map((p) => p.data.series!)),
].sort();
const allTags = [...new Set(posts.filter((p) => p.data.tags).flatMap((p) => p.data.tags!))].sort();

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.title,
	description: SITE.description,
	url: SITE.url,
	author: { '@type': 'Person', name: SITE.author, url: SITE.url },
};
---

<Layout title={SITE.title} jsonLd={jsonLd}>
	<!-- 最新博客 -->
	<section class="blog-section">
		<div class="section-header">
			<h2>
				<Icon name="newspaper" size={20} />
				最新文章
			</h2>
			<a href="/blog" class="view-more">
				查看全部
				<Icon name="arrow-right" size={16} />
			</a>
		</div>
		<div class="posts-list">
			{latestPosts.length === 0 ? (
				<p class="no-posts">暂无文章，敬请期待！</p>
			) : (
				latestPosts.map((post) => (
					<a href={`/blog/${post.id}`} class="post-card">
						<div class="post-meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('zh-CN', {
									month: 'long',
									day: 'numeric',
									year: 'numeric',
								})}
							</time>
						</div>
						<h3>{post.data.title}</h3>
						<p class="excerpt">{post.data.description}</p>
					</a>
				))
			)}
		</div>
	</section>

	<!-- 精选项目 -->
	<section class="projects-section">
		<div class="section-header">
			<h2>
				<Icon name="folder" size={20} />
				项目作品
			</h2>
			<a href="/projects" class="view-more">
				查看全部
				<Icon name="arrow-right" size={16} />
			</a>
		</div>
		<div class="projects-grid">
			{featuredProjects.map((project) => (
				<a
					href={project.data.github}
					target="_blank"
					rel="noopener noreferrer"
					class="project-card"
				>
					<div class="card-icon">
						<Icon name="folder" size={28} strokeWidth={1.5} />
					</div>
					<h3>{project.data.title}</h3>
					<p>{project.data.description}</p>
					<div class="tech-stack">
						{project.data.tech.map((tech) => (
							<span class="tech-tag">{tech}</span>
						))}
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- 站点总浏览量（GoatCounter）：沉底小字，不单独占一条分隔栏 -->
	<p class="site-visits">
		总浏览 <span id="visitCount">—</span>
	</p>

	<!-- 右栏：写作主题入口 -->
	<Fragment slot="right">
		<aside class="side-panel">
			{allSeries.length > 0 && (
				<div class="side-panel-section">
					<div class="side-panel-title">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
						</svg>
						<span>系列</span>
					</div>
					<nav>
						<a class="side-panel-item" href="/blog">
							全部文章
						</a>
						{allSeries.map((series) => (
							<a
								class="side-panel-item"
								href={`/blog?series=${encodeURIComponent(series)}`}
							>
								{series}
							</a>
						))}
					</nav>
				</div>
			)}

			{allTags.length > 0 && (
				<div class="side-panel-section">
					<div class="side-panel-title">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
							<line x1="7" y1="7" x2="7.01" y2="7" />
						</svg>
						<span>标签</span>
					</div>
					<nav class="tag-cloud">
						{allTags.map((tag) => (
							<a class="tag-pill" href={`/blog?tag=${encodeURIComponent(tag)}`}>
								{tag}
							</a>
						))}
					</nav>
				</div>
			)}
		</aside>
	</Fragment>
</Layout>

<script>
	import { GOATCOUNTER } from '../config';

	// 站点总浏览量（GoatCounter TOTAL；服务端最长缓存 4 小时）
	function initVisitorCounter() {
		const visitCountEl = document.getElementById('visitCount');
		if (!visitCountEl) return;

		fetch(`https://${GOATCOUNTER.code}.goatcounter.com/counter/TOTAL.json`)
			.then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
			.then((data) => {
				if (typeof data.count === 'string') visitCountEl.textContent = data.count;
			})
			.catch(() => {
				// 统计服务不可用时保持显示 "—"
			});
	}

	document.addEventListener('astro:page-load', initVisitorCounter);
</script>

<style>
	/* 首页独有：区块间距与底部计数（卡片/网格/按钮等在全局 CSS） */
	.blog-section {
		padding: 0 0 3rem;
	}

	.projects-section {
		padding: 3rem 0;
		border-top: 1px solid var(--color-border);
	}

	.site-visits {
		margin: 2.5rem 0 0;
		text-align: center;
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	.site-visits span {
		margin-left: 0.35rem;
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-primary);
	}
</style>
