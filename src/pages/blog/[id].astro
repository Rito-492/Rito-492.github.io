---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout title={post.data.title}>
	<header class="post-nav" id="postNav">
		<div class="post-nav-content">
			<a href="/blog" class="post-nav-back">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6"/>
				</svg>
			</a>
			<div class="post-nav-info">
				<h2>{post.data.title}</h2>
				{post.data.series && <span class="post-nav-series">{post.data.series}</span>}
			</div>
		</div>
	</header>
	<article class="post">
		<header class="post-header">
			<h1>{post.data.title}</h1>
			<div class="post-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('zh-CN', {
						year: 'numeric',
						month: 'long',
						day: 'numeric'
					})}
				</time>
				{post.data.lastUpdated && (
					<span class="last-updated">
						· 最后更新：{new Date(post.data.lastUpdated).toLocaleDateString('zh-CN', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
							hour: '2-digit',
							minute: '2-digit'
						})}
					</span>
				)}
				{post.data.tags && (
					<div class="tags">
						{post.data.tags.map((tag) => (
							<span class="tag">#{tag}</span>
						))}
					</div>
				)}
			</div>
		</header>
		<div class="post-content">
			<Content />
		</div>
	</article>
	<div class="back-to-blog">
		<a href="/blog">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="m15 18-6-6 6-6"/>
			</svg>
			<span>返回博客列表</span>
		</a>
	</div>
</PostLayout>

<script>
	// 悬浮导航栏逻辑
	const postNav = document.getElementById('postNav');
	const postHeader = document.querySelector('.post-header');

	if (postNav && postHeader) {
		const navHeight = postNav.offsetHeight;
		const triggerHeight = postHeader.offsetHeight + 20;

		window.addEventListener('scroll', () => {
			const scrollTop = window.scrollY;
			if (scrollTop >= triggerHeight) {
				postNav.classList.add('floating');
			} else {
				postNav.classList.remove('floating');
			}
		});
	}
</script>

<style>
	.post {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 0;
	}

	/* 悬浮导航栏 */
	.post-nav {
		position: fixed;
		top: -70px;
		left: 0;
		right: 0;
		background: var(--color-nav-bg);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
		z-index: 99;
		transition: top 0.3s ease;
		box-shadow: 0 1px 3px var(--color-shadow);
	}

	.post-nav.floating {
		top: 0;
	}

	.post-nav-content {
		max-width: 800px;
		margin: 0 auto;
		padding: 0.75rem 2rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.post-nav-back {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: rgba(8, 145, 178, 0.05);
		border: 1px solid rgba(8, 145, 178, 0.3);
		color: var(--color-primary);
		transition: all 0.2s;
		text-decoration: none;
	}

	.post-nav-back:hover {
		background: rgba(8, 145, 178, 0.1);
		border-color: var(--color-primary);
		transform: translateX(-2px);
	}

	.post-nav-info {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.post-nav-info h2 {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.post-nav-series {
		font-size: 0.8rem;
		color: var(--color-primary);
		background: rgba(8, 145, 178, 0.08);
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
		white-space: nowrap;
	}

	.post-header {
		margin-bottom: 2rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
	}

	.post-header h1 {
		margin-bottom: 0.75rem;
	}

	.post-meta {
		display: flex;
		gap: 1rem;
		align-items: center;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		flex-wrap: wrap;
	}

	.last-updated {
		font-size: 0.85rem;
		color: var(--color-primary);
	}

	.tags {
		display: flex;
		gap: 0.5rem;
	}

	.tag {
		color: var(--color-primary);
	}

	.post-content {
		line-height: 1.8;
		padding-bottom: 6rem;
		border-bottom: 1px dashed var(--color-border);
	}

	.back-to-blog {
		margin-top: 3rem;
		text-align: center;
		padding-bottom: 4rem;
	}

	.back-to-blog a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		padding: 0.75rem 1.5rem;
		border-radius: 12px;
		border: 1px solid rgba(8, 145, 178, 0.3);
		background: rgba(8, 145, 178, 0.05);
		transition: all 0.3s;
		box-shadow: 0 2px 8px rgba(8, 145, 178, 0.08);
	}

	.back-to-blog a:hover {
		background: rgba(8, 145, 178, 0.1);
		border-color: var(--color-primary);
		transform: translateY(-2px);
		box-shadow: 0 4px 16px rgba(8, 145, 178, 0.15);
	}

	.back-to-blog svg {
		transition: transform 0.3s;
	}

	.back-to-blog a:hover svg {
		transform: translateX(-4px);
	}
</style>
