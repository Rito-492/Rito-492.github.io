---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
	return data.isPublished;
});

const sortedPosts = posts.sort((a, b) => {
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const allSeries = [
	...new Set(posts.filter((p) => p.data.series).map((p) => p.data.series!)),
].sort();
const allTags = [...new Set(posts.filter((p) => p.data.tags).flatMap((p) => p.data.tags!))].sort();
---

<Layout title="Blog - Rito-492" hideProfileOnMobile>
	<!-- 标题行 -->
	<header class="blog-header">
		<div class="header-top">
			<span class="float-icon">
				<Icon name="notebook-pen" size={22} />
			</span>
			<h1>Blog</h1>
		</div>
		<p class="header-desc">表达一些我的想法</p>
		<div class="header-stats">
			<span class="stat-item" id="postsTotal">
				<strong>{posts.length}</strong> {posts.length === 1 ? 'post' : 'posts'}
			</span>
			<span class="stat-item result-info" id="resultInfo"></span>
			<button type="button" class="stat-clear" data-clear hidden>
				Clear
			</button>
		</div>
	</header>

	<!-- 窄屏筛选：右栏在手机上不渲染，改由一行 chip 承担同样的筛选/排序 -->
	<div class="mobile-filters">
		<div class="chip-row">
			<button type="button" class="filter-chip active" data-series="all">
				All
			</button>
			{allSeries.map((series) => (
				<button type="button" class="filter-chip" data-series={series}>
					{series}
				</button>
			))}
			<span class="chip-sep" aria-hidden="true"></span>
			<button type="button" class="filter-chip chip-sort" data-sort>
				<Icon name="arrow-up-down" size={13} />
				<span data-sort-label>Newest</span>
			</button>
		</div>
		{allTags.length > 0 && (
			<div class="chip-row">
				{allTags.map((tag) => (
					<button type="button" class="filter-chip chip-tag" data-tag={tag}>
						{tag}
					</button>
				))}
			</div>
		)}
	</div>

	<div class="posts-list" id="postsList">
		{sortedPosts.length === 0 ? (
			<div class="empty-state">
				<span class="empty-icon">
					<Icon name="sprout" size={48} strokeWidth={1.5} />
				</span>
				<p class="no-posts">还没有文章，敬请期待！</p>
			</div>
		) : (
			sortedPosts.map((post) => (
				<a
					href={`/blog/${post.id}`}
					class="post-card"
					data-series={post.data.series ?? ''}
					data-tags={JSON.stringify(post.data.tags ?? [])}
					data-date={post.data.pubDate.toISOString()}
				>
					<div class="post-title-row">
						<h3 class="post-title">{post.data.title}</h3>
						<span class="post-arrow">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</span>
					</div>
					<p class="post-desc">{post.data.description}</p>
					<div class="post-foot">
						<time class="post-date" datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('zh-CN', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</time>
						<span class="foot-sep">·</span>
						<span class="foot-reading">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<circle cx="12" cy="12" r="10" />
								<polyline points="12 6 12 12 16 14" />
							</svg>
							{Math.max(1, Math.ceil(post.body.length / 500))} 分钟
						</span>
						{post.data.series && (
							<>
								<span class="foot-sep">·</span>
								<span class="foot-series">{post.data.series}</span>
							</>
						)}
						{post.data.tags && post.data.tags.length > 0 && (
							<>
								<span class="foot-sep">·</span>
								{post.data.tags.map((tag) => (
									<span class="foot-tag">{tag}</span>
								))}
							</>
						)}
					</div>
				</a>
			))
		)}
	</div>

	<div class="empty-state filter-empty" id="filterEmpty" hidden>
		<span class="empty-icon">
			<Icon name="sprout" size={48} strokeWidth={1.5} />
		</span>
		<p class="no-posts">没有符合筛选条件的文章</p>
	</div>

	<Fragment slot="right">
		<aside class="side-panel">
			{allSeries.length > 0 && (
				<div class="side-panel-section">
					<div class="side-panel-title">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
						</svg>
						<span>Series</span>
					</div>
					<nav id="seriesFilter">
						<a class="side-panel-item active" data-series="all">
							{' '}
							All{' '}
						</a>
						{allSeries.map((series) => (
							<a class="side-panel-item" data-series={series}>
								{series}
							</a>
						))}
					</nav>
				</div>
			)}

			{allTags.length > 0 && (
				<div class="side-panel-section">
					<div class="side-panel-title">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
							<line x1="7" y1="7" x2="7.01" y2="7" />
						</svg>
						<span>Tags</span>
					</div>
					<nav id="tagFilter" class="tag-cloud">
						{allTags.map((tag) => (
							<a class="tag-pill" data-tag={tag}>
								{tag}
							</a>
						))}
					</nav>
					<a class="side-panel-item clear-item" id="clearTags" style="display:none">
						Clear filters
					</a>
				</div>
			)}

			<div class="side-panel-section">
				<div class="side-panel-title">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m3 16 4 4 4-4" />
						<path d="M7 20V4" />
						<path d="M21 8l-4-4-4 4" />
						<path d="M17 4v16" />
					</svg>
					<span>Sort</span>
				</div>
				<nav>
					<a class="side-panel-item" id="sortBtn" data-sort>
						<span id="sortLabel" data-sort-label>
							Newest
						</span>
					</a>
				</nav>
			</div>
		</aside>
	</Fragment>
</Layout>

<style>
	/* 列表页独有：页头 + 卡片内部细节（三栏外壳 / 卡片壳 / 侧栏 / 标签云在全局 CSS） */
	.blog-header {
		padding: 0.5rem 0 2rem;
	}

	.header-top {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.blog-header h1 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.header-desc {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin: 0;
	}

	.header-stats {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-top: 0.75rem;
	}

	.stat-item {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.stat-item strong {
		color: var(--color-primary);
		font-weight: 600;
	}

	/* 有标签筛选时的清除入口（放在统计行，避免 chip 行里落单换行） */
	.stat-clear {
		padding: 0;
		border: none;
		background: none;
		font-family: inherit;
		font-size: 0.8rem;
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
		cursor: pointer;
	}

	.stat-clear[hidden] {
		display: none;
	}

	/* 卡片内部：标题行 + 箭头 + 摘要 + 元信息行（卡片壳在全局 CSS） */
	.post-card:hover .post-title {
		color: var(--color-primary);
	}

	.post-card:hover .post-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	.post-title-row {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.post-title {
		flex: 1;
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.post-arrow {
		flex-shrink: 0;
		color: var(--color-text-muted);
		opacity: 0;
		transform: translateX(-6px);
		transition: all var(--transition-fast);
		padding-top: 0.2rem;
	}

	.post-desc {
		color: var(--color-text-muted);
		font-size: 0.88rem;
		line-height: 1.65;
		margin: 0 0 0.75rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-foot {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.foot-reading {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.foot-sep {
		color: var(--color-border);
		user-select: none;
	}

	.foot-series {
		color: var(--color-primary);
		font-weight: 500;
	}

	.foot-tag {
		color: var(--color-primary);
		background: rgba(var(--color-primary-rgb), 0.08);
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
	}

	.clear-item {
		font-size: 0.8rem;
		margin-top: 0.25rem;
	}

	/* 窄屏 chip 筛选（桌面端用右栏，这里默认不渲染） */
	.mobile-filters {
		display: none;
	}

	@media (max-width: 1320px) {
		.mobile-filters {
			display: block;
			margin-bottom: 0.25rem;
		}

		.chip-row {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.4rem;
			padding-bottom: 0.55rem;
		}

		.filter-chip {
			flex: 0 0 auto;
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
			padding: 0.3rem 0.65rem;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-full);
			background: transparent;
			color: var(--color-text-muted);
			font-family: inherit;
			font-size: 0.76rem;
			line-height: 1.5;
			white-space: nowrap;
			cursor: pointer;
			transition:
				color var(--transition-fast),
				border-color var(--transition-fast),
				background-color var(--transition-fast);
		}

		.filter-chip:hover {
			color: var(--color-text);
			border-color: var(--color-text-muted);
		}

		.filter-chip.active {
			color: var(--color-primary);
			border-color: var(--color-primary);
			background: rgba(var(--color-primary-rgb), 0.08);
		}

		.filter-chip.chip-tag {
			border-color: transparent;
			background: rgba(var(--color-primary-rgb), 0.06);
		}

		.filter-chip.chip-tag.active {
			background: rgba(var(--color-primary-rgb), 0.14);
			font-weight: 500;
		}

		.chip-sep {
			flex: 0 0 auto;
			width: 1px;
			height: 1rem;
			background: var(--color-border);
		}
	}
</style>

<script>
	// 列表页交互：筛选 / 排序 / URL 参数
	// 桌面端控件在右栏（#seriesFilter / #tagFilter / #sortBtn），窄屏控件是正文顶部的 chip 行
	// （.mobile-filters）。两套控件共享同一份状态，点任何一处都会同步另一处。
	type ListState = { series: string; tags: Set<string>; newest: boolean };
	const listState: ListState = { series: 'all', tags: new Set(), newest: true };

	const FILTER_CONTROL =
		'#seriesFilter [data-series], .mobile-filters [data-series], #tagFilter [data-tag], .mobile-filters [data-tag], [data-sort], [data-clear], #clearTags';

	function renderList() {
		const postsList = document.getElementById('postsList');
		const resultInfo = document.getElementById('resultInfo');
		if (!postsList || !resultInfo) return;

		const rows = Array.from(postsList.querySelectorAll<HTMLElement>('.post-card'));
		let visible = 0;

		rows.forEach((row) => {
			const series = row.dataset.series ?? '';
			const tags: string[] = JSON.parse(row.dataset.tags ?? '[]');
			const seriesMatch = listState.series === 'all' || series === listState.series;
			const tagsMatch = listState.tags.size === 0 || tags.some((t) => listState.tags.has(t));
			const show = seriesMatch && tagsMatch;
			row.style.display = show ? '' : 'none';
			if (show) visible++;
		});

		resultInfo.textContent =
			listState.tags.size > 0 || listState.series !== 'all'
				? `${visible} ${visible === 1 ? 'post' : 'posts'} found`
				: '';

		// 筛选结果为空时的提示（"还没有文章"的空状态只由服务端分支负责）
		const filterEmpty = document.getElementById('filterEmpty');
		if (filterEmpty) filterEmpty.hidden = !(visible === 0 && postsList.children.length > 0 && (listState.tags.size > 0 || listState.series !== 'all'));

		const sorted = rows
			.filter((r) => r.style.display !== 'none')
			.sort((a, b) => {
				const diff = (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
				return listState.newest ? -diff : diff;
			});
		sorted.forEach((r) => postsList.appendChild(r));
	}

	function syncControls() {
		document.querySelectorAll<HTMLElement>('[data-series], [data-tag]').forEach((el) => {
			// 文章卡片也带 data-series / data-tags，只同步控件区域的元素
			if (!el.closest('#seriesFilter, #tagFilter, .mobile-filters')) return;
			if (el.dataset.series !== undefined)
				el.classList.toggle('active', el.dataset.series === listState.series);
			else if (el.dataset.tag !== undefined)
				el.classList.toggle('active', listState.tags.has(el.dataset.tag));
		});

		document.querySelectorAll<HTMLElement>('[data-sort-label]').forEach((el) => {
			el.textContent = listState.newest ? 'Newest' : 'Oldest';
		});

		const clearTags = document.getElementById('clearTags');
		if (clearTags) clearTags.style.display = listState.tags.size > 0 ? '' : 'none';
		document.querySelectorAll<HTMLElement>('[data-clear]').forEach((el) => {
			el.hidden = listState.tags.size === 0;
		});

		// 有筛选时只显示"找到 N 篇"，避免"3 posts  1 post found"两个计数并列
		const filtering = listState.tags.size > 0 || listState.series !== 'all';
		const postsTotal = document.getElementById('postsTotal');
		if (postsTotal) postsTotal.style.display = filtering ? 'none' : '';
	}

	// 文档级监听只绑一次；目标元素在回调里实时查询（View Transitions 安全）
	document.addEventListener('click', (e) => {
		const target = (e.target as HTMLElement).closest<HTMLElement>(FILTER_CONTROL);
		if (!target) return;

		if (target.dataset.series !== undefined) {
			listState.series = target.dataset.series;
		} else if (target.dataset.tag !== undefined) {
			const tag = target.dataset.tag;
			if (listState.tags.has(tag)) listState.tags.delete(tag);
			else listState.tags.add(tag);
		} else if (target.hasAttribute('data-sort')) {
			listState.newest = !listState.newest;
		} else if (target.hasAttribute('data-clear') || target.id === 'clearTags') {
			listState.tags.clear();
		} else {
			return;
		}

		syncControls();
		renderList();
	});

	function initBlogList() {
		const postsList = document.getElementById('postsList');
		const resultInfo = document.getElementById('resultInfo');
		if (!postsList || !resultInfo) return;

		listState.series = 'all';
		listState.tags.clear();
		listState.newest = true;

		// URL 参数（首页等入口的系列 / 标签直达）
		const params = new URLSearchParams(window.location.search);
		const seriesParam = params.get('series');
		const tagParam = params.get('tag');
		const hasSeries = (value: string) =>
			Array.from(document.querySelectorAll<HTMLElement>('#seriesFilter [data-series]')).some(
				(el) => el.dataset.series === value,
			);
		const hasTag = (value: string) =>
			Array.from(document.querySelectorAll<HTMLElement>('#tagFilter [data-tag]')).some(
				(el) => el.dataset.tag === value,
			);

		if (seriesParam && hasSeries(seriesParam)) listState.series = seriesParam;
		if (tagParam && hasTag(tagParam)) listState.tags.add(tagParam);

		syncControls();
		renderList();
	}

	document.addEventListener('astro:page-load', initBlogList);
</script>
