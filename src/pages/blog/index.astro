---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
	return !data.draft;
});

function parseDate(dateStr: string): Date {
	const year = parseInt(dateStr.substring(0, 4));
	const month = parseInt(dateStr.substring(4, 6)) - 1;
	const day = parseInt(dateStr.substring(6, 8));
	const hour = parseInt(dateStr.substring(8, 10));
	const minute = parseInt(dateStr.substring(10, 12));
	return new Date(year, month, day, hour, minute);
}

const sortedPosts = posts.sort((a, b) => {
	return parseDate(b.data.pubDate).valueOf() - parseDate(a.data.pubDate).valueOf();
});

const allSeries = [...new Set(posts.filter(p => p.data.series).map(p => p.data.series!))].sort();
const allTags = [...new Set(posts.filter(p => p.data.tags).flatMap(p => p.data.tags!))].sort();
---

<Layout title="博客 - Rito">
	<div class="blog-layout">
		<main class="blog-main">
			<header class="blog-header">
				<div class="header-top">
					<span class="header-icon">📝</span>
					<h1>博客</h1>
				</div>
				<p class="header-desc">表达一些我的想法</p>
				<div class="header-stats">
					<span class="stat-item">共 <strong>{posts.length}</strong> 篇</span>
					<span class="stat-item result-info" id="resultInfo"></span>
				</div>
			</header>

			<div class="posts-list" id="postsList">
				{sortedPosts.length === 0 ? (
					<div class="empty-state">
						<span class="empty-icon">🌱</span>
						<p class="no-posts">还没有文章，敬请期待！</p>
					</div>
				) : (
					sortedPosts.map((post) => (
						<a href={`/blog/${post.id}`} class="post-card"
							 data-series={post.data.series ?? ''}
							 data-tags={JSON.stringify(post.data.tags ?? [])}
							 data-date={post.data.pubDate}>
							<div class="post-title-row">
								<h3 class="post-title">{post.data.title}</h3>
								<span class="post-arrow">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
								</span>
							</div>
							<p class="post-desc">{post.data.description}</p>
							<div class="post-foot">
								<time class="post-date" datetime={parseDate(post.data.pubDate).toISOString()}>
									{parseDate(post.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
								</time>
								<span class="foot-sep">·</span>
								<span class="foot-reading">
									<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									{Math.max(1, Math.ceil(post.body.length / 500))} 分钟
								</span>
								{post.data.series && (
									<>
										<span class="foot-sep">·</span>
										<span class="foot-series">{post.data.series}</span>
									</>
								)}
								{post.data.tags && post.data.tags.length > 0 && (
									<>
										<span class="foot-sep">·</span>
										{post.data.tags.map(tag => (
											<span class="foot-tag">{tag}</span>
										))}
									</>
								)}
							</div>
						</a>
					))
				)}
			</div>
		</main>

		<aside class="blog-sidebar">
			{allSeries.length > 0 && (
				<div class="sidebar-section">
					<div class="sidebar-label">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
						<span>系列</span>
					</div>
					<nav id="seriesFilter">
						<a class="sidebar-item active" data-series="all">全部</a>
						{allSeries.map(series => (
							<a class="sidebar-item" data-series={series}>{series}</a>
						))}
					</nav>
				</div>
			)}

			{allTags.length > 0 && (
				<div class="sidebar-section">
					<div class="sidebar-label">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
						<span>标签</span>
					</div>
					<nav id="tagFilter" class="tag-cloud">
						{allTags.map(tag => (
							<a class="tag-pill" data-tag={tag}>{tag}</a>
						))}
					</nav>
					<a class="sidebar-item clear-item" id="clearTags" style="display:none">清除筛选</a>
				</div>
			)}

			<div class="sidebar-section">
				<div class="sidebar-label">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="M21 8l-4-4-4 4"/><path d="M17 4v16"/></svg>
					<span>排序</span>
				</div>
				<nav>
					<a class="sidebar-item" id="sortBtn">
						<span id="sortLabel">最新优先</span>
					</a>
				</nav>
			</div>
		</aside>
	</div>
</Layout>

<style>
	.blog-layout {
		display: grid;
		grid-template-columns: 25% 50% 25%;
		gap: 2rem;
		padding: 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}
	main.blog-main {
		grid-column: 2;
		min-width: 0;
		max-width: none !important;
		padding: 0 !important;
		margin: 0;
	}
	.blog-sidebar {
		grid-column: 3;
		position: sticky;
		top: 5rem;
		height: fit-content;
		max-height: calc(100vh - 7rem);
		overflow-y: auto;
		padding: 1.25rem 0;
		border-left: 1px solid var(--color-border);
	}

	.sidebar-section { margin-bottom: 1.5rem; }
	.sidebar-section:last-child { margin-bottom: 0; }
	.sidebar-label {
		display: flex; align-items: center; gap: 0.5rem;
		font-size: 1rem; font-weight: 600; color: var(--color-primary);
		margin-bottom: 0.75rem; padding-left: 0.25rem;
	}
	.sidebar-label svg { width: 16px; height: 16px; flex-shrink: 0; }

	.sidebar-item {
		display: block;
		padding: 0.35rem 0.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		line-height: 1.5;
		border-left: 2px solid transparent;
		transition: all 0.15s;
		cursor: pointer;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sidebar-item:hover { color: var(--color-text); border-left-color: var(--color-primary); }
	.sidebar-item.active {
		color: var(--color-primary);
		border-left-color: var(--color-primary);
		font-weight: 500;
	}
	.clear-item { font-size: 0.8rem; margin-top: 0.25rem; }

	/* Header */
	.blog-header { padding: 0.5rem 0 2rem; }
	.header-top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
	.header-icon { font-size: 1.5rem; animation: float 3s ease-in-out infinite; }
	@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
	.blog-header h1 { margin: 0; font-size: 1.5rem; font-weight: 700; }
	.header-desc { color: var(--color-text-muted); font-size: 0.85rem; margin: 0; }
	.header-stats { display: flex; gap: 1rem; align-items: center; margin-top: 0.75rem; }
	.stat-item { font-size: 0.8rem; color: var(--color-text-muted); }
	.stat-item strong { color: var(--color-primary); font-weight: 600; }
	.result-info { font-size: 0.8rem; color: var(--color-text-muted); }

	/* Posts list */
	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-card {
		display: block;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.25rem 1.5rem;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s;
	}

	.post-card:hover {
		border-color: var(--color-primary);
		box-shadow: 0 4px 16px rgba(8,145,178,0.1);
		transform: translateY(-1px);
	}
	.post-card:hover .post-title { color: var(--color-primary); }
	.post-card:hover .post-arrow { opacity: 1; transform: translateX(0); }

	/* Title + arrow */
	.post-title-row {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.post-title {
		flex: 1;
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-text);
		transition: color 0.2s;
	}

	.post-arrow {
		flex-shrink: 0;
		color: var(--color-text-muted);
		opacity: 0;
		transform: translateX(-6px);
		transition: all 0.2s;
		padding-top: 0.2rem;
	}

	/* Description */
	.post-desc {
		color: var(--color-text-muted);
		font-size: 0.88rem;
		line-height: 1.65;
		margin: 0 0 0.75rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Foot */
	.post-foot {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.post-date { color: var(--color-text-muted); }

	.foot-reading {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.foot-sep { color: var(--color-border); user-select: none; }

	.foot-series {
		color: var(--color-primary);
		font-weight: 500;
	}

	.foot-tag {
		color: var(--color-primary);
		background: rgba(8,145,178,0.08);
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
	}

	/* Empty state */
	.empty-state { text-align: center; padding: 4rem 2rem; }
	.empty-icon { font-size: 4rem; display: block; margin-bottom: 1rem; }
	.no-posts { color: var(--color-text-muted); font-size: 1.1rem; }

	/* Tag cloud */
	.tag-cloud { display: flex; flex-wrap: wrap; gap: 0.6rem; padding-left: 0.5rem; }
	.tag-pill {
		color: var(--color-text-muted);
		font-size: 0.78rem;
		text-decoration: none;
		cursor: pointer;
		transition: color 0.15s;
	}
	.tag-pill:hover { color: var(--color-primary); }
	.tag-pill.active { color: var(--color-primary); font-weight: 500; }

	@media (max-width: 1150px) {
		.blog-layout { grid-template-columns: 1fr; padding: 1.5rem 1rem; }
		.blog-main { grid-column: 1; }
		.blog-sidebar { grid-column: 1; position: static; max-height: none; border-top: 1px solid var(--color-border); padding: 1.5rem 0 0; margin-top: 2rem; }
	}
</style>

<script>
	// ---- state ----
	const activeTags = new Set<string>();
	let activeSeries = 'all';
	let sortNewest = true;

	// ---- DOM refs ----
	const postsList = document.getElementById('postsList')!;
	const resultInfo = document.getElementById('resultInfo')!;
	const sortLabel = document.getElementById('sortLabel')!;
	const clearTagsBtn = document.getElementById('clearTags')!;
	const rows = Array.from(postsList.querySelectorAll('.post-card')) as HTMLElement[];

	function updateAll() {
		let visible = 0;
		rows.forEach(row => {
			const series = row.dataset.series ?? '';
			const tags: string[] = JSON.parse(row.dataset.tags ?? '[]');

			const seriesMatch = activeSeries === 'all' || series === activeSeries;
			const tagsMatch = activeTags.size === 0 || tags.some(t => activeTags.has(t));

			if (seriesMatch && tagsMatch) {
				row.style.display = '';
				visible++;
			} else {
				row.style.display = 'none';
			}
		});

		if (activeTags.size > 0 || activeSeries !== 'all') {
			resultInfo.textContent = `筛选出 ${visible} 篇`;
		} else {
			resultInfo.textContent = '';
		}

		clearTagsBtn.style.display = activeTags.size > 0 ? '' : 'none';
		applySort();
	}

	function applySort() {
		const container = postsList;
		const visibleRows = rows.filter(r => r.style.display !== 'none');
		const sorted = [...visibleRows].sort((a, b) => {
			const diff = (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
			return sortNewest ? -diff : diff;
		});
		sorted.forEach(r => container.appendChild(r));
	}

	// ---- series filter ----
	document.getElementById('seriesFilter')!.addEventListener('click', (e) => {
		const item = (e.target as HTMLElement).closest('.sidebar-item') as HTMLElement;
		if (!item) return;
		document.querySelectorAll('#seriesFilter .sidebar-item').forEach(el => el.classList.remove('active'));
		item.classList.add('active');
		activeSeries = item.dataset.series!;
		updateAll();
	});

	// ---- tag filter ----
	document.getElementById('tagFilter')!.addEventListener('click', (e) => {
		const item = (e.target as HTMLElement).closest('.tag-pill') as HTMLElement;
		if (!item) return;
		const tag = item.dataset.tag!;
		if (activeTags.has(tag)) {
			activeTags.delete(tag);
			item.classList.remove('active');
		} else {
			activeTags.add(tag);
			item.classList.add('active');
		}
		updateAll();
	});

	// ---- clear tags ----
	clearTagsBtn.addEventListener('click', () => {
		activeTags.clear();
		document.querySelectorAll('.tag-pill').forEach(b => b.classList.remove('active'));
		updateAll();
	});

	// ---- sort ----
	document.getElementById('sortBtn')!.addEventListener('click', () => {
		sortNewest = !sortNewest;
		sortLabel.textContent = sortNewest ? '最新优先' : '最早优先';
		applySort();
	});

	// ---- URL param ----
	const urlParams = new URLSearchParams(window.location.search);
	const urlTag = urlParams.get('tag');
	if (urlTag) {
		const tagBtn = document.querySelector(`.tag-pill[data-tag="${urlTag}"]`) as HTMLElement;
		if (tagBtn) tagBtn.click();
	}
</script>
