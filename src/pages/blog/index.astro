---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
	return data.isPublished;
});

const sortedPosts = posts.sort((a, b) => {
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const allSeries = [
	...new Set(posts.filter((p) => p.data.series).map((p) => p.data.series!)),
].sort();
const allTags = [...new Set(posts.filter((p) => p.data.tags).flatMap((p) => p.data.tags!))].sort();
---

<Layout title="博客 - Rito">
	<!-- 标题行 -->
	<header class="blog-header">
		<div class="header-top">
			<span class="float-icon">
				<Icon name="notebook-pen" size={22} />
			</span>
			<h1>博客</h1>
		</div>
		<p class="header-desc">表达一些我的想法</p>
		<div class="header-stats">
			<span class="stat-item">
				{' '}
				共 <strong>{posts.length}</strong> 篇{' '}
			</span>
			<span class="stat-item result-info" id="resultInfo"></span>
		</div>
	</header>

	<div class="posts-list" id="postsList">
		{sortedPosts.length === 0 ? (
			<div class="empty-state">
				<span class="empty-icon">
					<Icon name="sprout" size={48} strokeWidth={1.5} />
				</span>
				<p class="no-posts">还没有文章，敬请期待！</p>
			</div>
		) : (
			sortedPosts.map((post) => (
				<a
					href={`/blog/${post.id}`}
					class="post-card"
					data-series={post.data.series ?? ''}
					data-tags={JSON.stringify(post.data.tags ?? [])}
					data-date={post.data.pubDate.toISOString()}
				>
					<div class="post-title-row">
						<h3 class="post-title">{post.data.title}</h3>
						<span class="post-arrow">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</span>
					</div>
					<p class="post-desc">{post.data.description}</p>
					<div class="post-foot">
						<time class="post-date" datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('zh-CN', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</time>
						<span class="foot-sep">·</span>
						<span class="foot-reading">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<circle cx="12" cy="12" r="10" />
								<polyline points="12 6 12 12 16 14" />
							</svg>
							{Math.max(1, Math.ceil(post.body.length / 500))} 分钟
						</span>
						{post.data.series && (
							<>
								<span class="foot-sep">·</span>
								<span class="foot-series">{post.data.series}</span>
							</>
						)}
						{post.data.tags && post.data.tags.length > 0 && (
							<>
								<span class="foot-sep">·</span>
								{post.data.tags.map((tag) => (
									<span class="foot-tag">{tag}</span>
								))}
							</>
						)}
					</div>
				</a>
			))
		)}
	</div>

	<Fragment slot="right">
		<aside class="side-panel">
			{allSeries.length > 0 && (
				<div class="side-panel-section">
					<div class="side-panel-title">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
						</svg>
						<span>系列</span>
					</div>
					<nav id="seriesFilter">
						<a class="side-panel-item active" data-series="all">
							{' '}
							全部{' '}
						</a>
						{allSeries.map((series) => (
							<a class="side-panel-item" data-series={series}>
								{series}
							</a>
						))}
					</nav>
				</div>
			)}

			{allTags.length > 0 && (
				<div class="side-panel-section">
					<div class="side-panel-title">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
							<line x1="7" y1="7" x2="7.01" y2="7" />
						</svg>
						<span>标签</span>
					</div>
					<nav id="tagFilter" class="tag-cloud">
						{allTags.map((tag) => (
							<a class="tag-pill" data-tag={tag}>
								{tag}
							</a>
						))}
					</nav>
					<a class="side-panel-item clear-item" id="clearTags" style="display:none">
						清除筛选
					</a>
				</div>
			)}

			<div class="side-panel-section">
				<div class="side-panel-title">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m3 16 4 4 4-4" />
						<path d="M7 20V4" />
						<path d="M21 8l-4-4-4 4" />
						<path d="M17 4v16" />
					</svg>
					<span>排序</span>
				</div>
				<nav>
					<a class="side-panel-item" id="sortBtn">
						<span id="sortLabel">最新优先</span>
					</a>
				</nav>
			</div>
		</aside>
	</Fragment>
</Layout>

<style>
	/* 列表页独有：页头 + 卡片内部细节（三栏外壳 / 卡片壳 / 侧栏 / 标签云在全局 CSS） */
	.blog-header {
		padding: 0.5rem 0 2rem;
	}

	.header-top {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.blog-header h1 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.header-desc {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin: 0;
	}

	.header-stats {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-top: 0.75rem;
	}

	.stat-item {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.stat-item strong {
		color: var(--color-primary);
		font-weight: 600;
	}

	/* 卡片内部：标题行 + 箭头 + 摘要 + 元信息行（卡片壳在全局 CSS） */
	.post-card:hover .post-title {
		color: var(--color-primary);
	}

	.post-card:hover .post-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	.post-title-row {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.post-title {
		flex: 1;
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.post-arrow {
		flex-shrink: 0;
		color: var(--color-text-muted);
		opacity: 0;
		transform: translateX(-6px);
		transition: all var(--transition-fast);
		padding-top: 0.2rem;
	}

	.post-desc {
		color: var(--color-text-muted);
		font-size: 0.88rem;
		line-height: 1.65;
		margin: 0 0 0.75rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-foot {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.foot-reading {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.foot-sep {
		color: var(--color-border);
		user-select: none;
	}

	.foot-series {
		color: var(--color-primary);
		font-weight: 500;
	}

	.foot-tag {
		color: var(--color-primary);
		background: rgba(var(--color-primary-rgb), 0.08);
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
	}

	.clear-item {
		font-size: 0.8rem;
		margin-top: 0.25rem;
	}
</style>

<script>
	// 列表页交互：筛选 / 排序 / URL 参数（View Transitions 安全，每次导航重新初始化）
	function initBlogList() {
		const postsList = document.getElementById('postsList');
		const resultInfo = document.getElementById('resultInfo');
		const sortLabel = document.getElementById('sortLabel');
		const clearTagsBtn = document.getElementById('clearTags');
		if (!postsList || !resultInfo || !sortLabel || !clearTagsBtn) return;

		const rows = Array.from(postsList.querySelectorAll('.post-card')) as HTMLElement[];

		const activeTags = new Set<string>();
		let activeSeries = 'all';
		let sortNewest = true;

		function updateAll() {
			let visible = 0;
			rows.forEach((row) => {
				const series = row.dataset.series ?? '';
				const tags: string[] = JSON.parse(row.dataset.tags ?? '[]');

				const seriesMatch = activeSeries === 'all' || series === activeSeries;
				const tagsMatch = activeTags.size === 0 || tags.some((t) => activeTags.has(t));

				if (seriesMatch && tagsMatch) {
					row.style.display = '';
					visible++;
				} else {
					row.style.display = 'none';
				}
			});

			if (activeTags.size > 0 || activeSeries !== 'all') {
				resultInfo.textContent = `筛选出 ${visible} 篇`;
			} else {
				resultInfo.textContent = '';
			}

			clearTagsBtn.style.display = activeTags.size > 0 ? '' : 'none';
			applySort();
		}

		function applySort() {
			const visibleRows = rows.filter((r) => r.style.display !== 'none');
			const sorted = [...visibleRows].sort((a, b) => {
				const diff = (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
				return sortNewest ? -diff : diff;
			});
			sorted.forEach((r) => postsList.appendChild(r));
		}

		// ---- series filter ----
		document.getElementById('seriesFilter')?.addEventListener('click', (e) => {
			const item = (e.target as HTMLElement).closest('.side-panel-item') as HTMLElement;
			if (!item) return;
			document
				.querySelectorAll('#seriesFilter .side-panel-item')
				.forEach((el) => el.classList.remove('active'));
			item.classList.add('active');
			activeSeries = item.dataset.series!;
			updateAll();
		});

		// ---- tag filter ----
		document.getElementById('tagFilter')?.addEventListener('click', (e) => {
			const item = (e.target as HTMLElement).closest('.tag-pill') as HTMLElement;
			if (!item) return;
			const tag = item.dataset.tag!;
			if (activeTags.has(tag)) {
				activeTags.delete(tag);
				item.classList.remove('active');
			} else {
				activeTags.add(tag);
				item.classList.add('active');
			}
			updateAll();
		});

		// ---- clear tags ----
		clearTagsBtn.addEventListener('click', () => {
			activeTags.clear();
			document.querySelectorAll('.tag-pill').forEach((b) => b.classList.remove('active'));
			updateAll();
		});

		// ---- sort ----
		document.getElementById('sortBtn')?.addEventListener('click', () => {
			sortNewest = !sortNewest;
			sortLabel.textContent = sortNewest ? '最新优先' : '最早优先';
			applySort();
		});

		// ---- URL 参数（首页右栏的系列/标签入口） ----
		const params = new URLSearchParams(window.location.search);
		const findItem = (selector: string, key: 'series' | 'tag', value: string) =>
			Array.from(document.querySelectorAll<HTMLElement>(selector)).find(
				(el) => el.dataset[key] === value,
			);

		const urlSeries = params.get('series');
		if (urlSeries) findItem('#seriesFilter .side-panel-item', 'series', urlSeries)?.click();

		const urlTag = params.get('tag');
		if (urlTag) findItem('#tagFilter .tag-pill', 'tag', urlTag)?.click();
	}

	document.addEventListener('astro:page-load', initBlogList);
</script>
