---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
	return !data.draft;
});

// 解析日期字符串 YYYYMMDDHHmm 为 Date 对象
function parseDate(dateStr: string): Date {
	const year = parseInt(dateStr.substring(0, 4));
	const month = parseInt(dateStr.substring(4, 6)) - 1;
	const day = parseInt(dateStr.substring(6, 8));
	const hour = parseInt(dateStr.substring(8, 10));
	const minute = parseInt(dateStr.substring(10, 12));
	return new Date(year, month, day, hour, minute);
}

const sortedPosts = posts.sort((a, b) => {
	return parseDate(b.data.pubDate).valueOf() - parseDate(a.data.pubDate).valueOf();
});

// 提取所有系列
const allSeries = [...new Set(posts.filter(p => p.data.series).map(p => p.data.series!))].sort();
---

<Layout title="博客 - Rito">
	<section class="blog-header">
		<div class="header-content">
			<span class="header-icon">📝</span>
			<h1>博客</h1>
			<p>在这里分享我的技术笔记和学习心得</p>
		</div>
	</section>

	<section class="posts-list">
		{allSeries.length > 0 && (
			<div class="series-filter">
				<button class="filter-btn active" data-series="all">全部</button>
				{allSeries.map((series) => (
					<button class="filter-btn" data-series={series}>{series}</button>
				))}
			</div>
		)}
		{sortedPosts.length === 0 ? (
			<div class="empty-state">
				<span class="empty-icon">🌱</span>
				<p class="no-posts">还没有文章，敬请期待！</p>
			</div>
		) : (
			sortedPosts.map((post) => (
				<article class="post-card" data-series={post.data.series ?? ''}>
					<div class="post-card-content">
						<div class="post-meta">
							<time datetime={parseDate(post.data.pubDate).toISOString()}>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
									<line x1="16" x2="16" y1="2" y2="6"/>
									<line x1="8" x2="8" y1="2" y2="6"/>
									<line x1="3" x2="21" y1="10" y2="10"/>
								</svg>
								{parseDate(post.data.pubDate).toLocaleDateString('zh-CN', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</time>
							<span class="reading-time">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"/>
									<polyline points="12 6 12 12 16 14"/>
								</svg>
								{Math.max(1, Math.ceil(post.body.length / 500))} 分钟阅读
							</span>
							{post.data.series && (
								<span class="series-tag">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
									</svg>
									{post.data.series}
								</span>
							)}
						</div>
						<h2>
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
						</h2>
						<p class="excerpt">{post.data.description}</p>
					</div>
					<a href={`/blog/${post.id}`} class="read-more">
						<span>阅读全文</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14"/>
							<path d="m12 5 7 7-7 7"/>
						</svg>
					</a>
				</article>
			))
		)}
	</section>
</Layout>

<style>
	.blog-header {
		text-align: center;
		padding: 3rem 0 4rem;
	}

	.header-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.header-icon {
		font-size: 3rem;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.blog-header h1 {
		margin-bottom: 0.5rem;
		position: relative;
	}

	.blog-header h1::after {
		content: '';
		position: absolute;
		bottom: -8px;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 3px;
		background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
		border-radius: 2px;
	}

	.blog-header p {
		color: var(--color-text-muted);
	}

	.posts-list {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 2rem;
	}

	.empty-icon {
		font-size: 4rem;
		display: block;
		margin-bottom: 1rem;
	}

	.no-posts {
		color: var(--color-text-muted);
		font-size: 1.1rem;
	}

	.series-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		justify-content: center;
	}

	.filter-btn {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 9999px;
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
		color: var(--color-text);
		cursor: pointer;
		transition: all 0.2s;
		font-family: inherit;
	}

	.filter-btn:hover {
		border-color: var(--color-primary);
		background: rgba(8, 145, 178, 0.05);
	}

	.filter-btn.active {
		background: var(--color-primary);
		color: #ffffff;
		border-color: var(--color-primary);
	}

	.post-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.5rem;
		transition: all 0.3s;
		box-shadow: 0 2px 8px var(--color-shadow);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		position: relative;
		overflow: hidden;
	}

	.post-card::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		height: 100%;
		width: 4px;
		background: linear-gradient(180deg, var(--color-primary), var(--color-primary-hover));
		transform: scaleY(0);
		transform-origin: top;
		transition: transform 0.3s;
	}

	.post-card-link:hover .post-card::before {
		transform: scaleY(1);
	}

	.post-card-link:hover .post-card {
		border-color: var(--color-primary);
		transform: translateX(4px);
		box-shadow: 0 4px 20px rgba(8, 145, 178, 0.15);
	}

	.post-card-link:hover h2 {
		color: var(--color-primary);
	}

	.post-card-content {
		flex: 1;
	}

	.post-meta {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		margin-bottom: 0.75rem;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		flex-wrap: wrap;
	}

	.post-meta time,
	.reading-time,
	.series-tag {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.series-tag {
		background: rgba(8, 145, 178, 0.08);
		color: var(--color-primary);
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 500;
		border: 1px solid rgba(8, 145, 178, 0.2);
	}

	.post-card h2 {
		margin: 0 0 0.75rem;
		font-size: 1.4rem;
		line-height: 1.4;
	}

	.post-card h2 a {
		color: var(--color-text);
		text-decoration: none;
		transition: color 0.2s;
	}

	.post-card h2 a:hover {
		color: var(--color-primary);
	}

	.excerpt {
		color: var(--color-text-muted);
		line-height: 1.7;
		margin-bottom: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		padding: 0.75rem 1rem;
		border-radius: 8px;
		border: 1px solid transparent;
		transition: all 0.2s;
		white-space: nowrap;
	}

	.read-more:hover {
		background: rgba(8, 145, 178, 0.1);
		border-color: rgba(8, 145, 178, 0.3);
	}

	.read-more svg {
		transition: transform 0.2s;
	}

	.read-more:hover svg {
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.post-card {
			flex-direction: column;
			align-items: flex-start;
		}

		.post-meta {
			flex-wrap: wrap;
			gap: 1rem;
		}

		.read-more {
			margin-top: 1rem;
		}
	}
</style>
<script>
	// 系列筛选功能
	const filterBtns = document.querySelectorAll('.filter-btn');
	const postCards = document.querySelectorAll('.post-card');

	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const series = btn.dataset.series;

			// 更新按钮状态
			filterBtns.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			// 筛选文章
			postCards.forEach(card => {
				if (series === 'all' || card.dataset.series === series) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		});
	});
</script>
