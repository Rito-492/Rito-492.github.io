---
// 社交链接（首页侧栏 / about 页共用），数据来自 src/config.ts
import { SOCIALS, type SocialId } from '../config';

interface Props {
	variant?: 'stack' | 'row';
	ids?: readonly SocialId[];
}

const { variant = 'stack', ids } = Astro.props;
// 按调用方传入的 ids 顺序渲染；不传则用配置默认顺序
const links = (ids ?? SOCIALS.map((s) => s.id))
	.map((id) => SOCIALS.find((s) => s.id === id))
	.filter((s): s is (typeof SOCIALS)[number] => Boolean(s));
const isExternal = (href: string) => href.startsWith('http');
---

<div class:list={['social-links', variant]}>
	{links.map((s) => (
		<a
			href={s.href}
			class="social-link"
			target={isExternal(s.href) ? '_blank' : undefined}
			rel={isExternal(s.href) ? 'noopener noreferrer' : undefined}
		>
			{s.id === 'email' && (
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<rect width="20" height="16" x="2" y="4" rx="2" />
					<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
				</svg>
			)}
			{s.id === 'github' && (
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="currentColor"
				>
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 4.348 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
				</svg>
			)}
			{s.id === 'steam' && (
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="currentColor"
				>
					<path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z" />
				</svg>
			)}
			<span>{s.label}</span>
		</a>
	))}
</div>

<style>
	.social-links {
		display: flex;
	}

	.social-links.stack {
		flex-direction: column;
		gap: 0.2rem;
		align-items: flex-start;
	}

	.social-links.row {
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: all 0.2s;
		border-radius: 8px;
	}

	.social-links.stack .social-link {
		font-size: 0.9rem;
		padding: 0.4rem 0.6rem;
		line-height: 1.4;
	}

	.social-links.row .social-link {
		font-size: 0.88rem;
		padding: 0.4rem 0.7rem;
	}

	.social-link svg {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	.social-link:hover {
		color: var(--color-primary);
		background: rgba(8, 145, 178, 0.06);
	}

	@media (max-width: 640px) {
		.social-links.row {
			flex-direction: column;
		}
	}
</style>
