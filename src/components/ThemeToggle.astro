---
---

<button
	id="theme-toggle"
	class="theme-toggle"
	type="button"
	aria-label="主题：跟随系统"
	title="主题：跟随系统"
>
	<svg
		class="icon icon-system"
		xmlns="http://www.w3.org/2000/svg"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<rect x="2" y="3" width="20" height="14" rx="2" />
		<line x1="8" y1="21" x2="16" y2="21" />
		<line x1="12" y1="17" x2="12" y2="21" />
	</svg>
	<svg
		class="icon icon-light"
		xmlns="http://www.w3.org/2000/svg"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2" />
		<path d="M12 20v2" />
		<path d="m4.93 4.93 1.41 1.41" />
		<path d="m17.66 17.66 1.41 1.41" />
		<path d="M2 12h2" />
		<path d="M20 12h2" />
		<path d="m6.34 17.66-1.41 1.41" />
		<path d="m19.07 4.93-1.41 1.41" />
	</svg>
	<svg
		class="icon icon-dark"
		xmlns="http://www.w3.org/2000/svg"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
	</svg>
</button>

<script>
	// 三态循环：跟随系统 → 浅色 → 深色 → 跟随系统
	const LABELS = { system: '跟随系统', light: '浅色', dark: '深色' } as const;
	const ORDER = ['system', 'light', 'dark'] as const;
	type Theme = (typeof ORDER)[number];

	const btn = document.getElementById('theme-toggle');

	function resolvedTheme(): 'light' | 'dark' {
		const forced = document.documentElement.getAttribute('data-theme');
		if (forced === 'light' || forced === 'dark') return forced;
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function announce() {
		// 通知需要跟随主题的组件（如 Giscus 评论区）
		document.dispatchEvent(
			new CustomEvent('themechange', { detail: { theme: resolvedTheme() } }),
		);
	}

	if (btn) {
		const apply = (mode: Theme) => {
			if (mode === 'system') {
				document.documentElement.removeAttribute('data-theme');
				localStorage.removeItem('theme');
			} else {
				document.documentElement.setAttribute('data-theme', mode);
				localStorage.setItem('theme', mode);
			}
			btn.dataset.mode = mode;
			const label = `主题：${LABELS[mode]}`;
			btn.setAttribute('aria-label', label);
			btn.title = label;
			announce();
		};

		const stored = localStorage.getItem('theme') as Theme | null;
		apply(ORDER.includes(stored as Theme) ? (stored as Theme) : 'system');

		btn.addEventListener('click', () => {
			const current = (btn.dataset.mode as Theme) || 'system';
			const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
			apply(next);
		});

		// 跟随系统模式下，系统主题变化时同步通知
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
			if (!document.documentElement.hasAttribute('data-theme')) announce();
		});
	}
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: none;
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: all 0.2s;
	}

	.theme-toggle:hover {
		color: var(--color-primary);
		background: rgba(8, 145, 178, 0.08);
	}

	.theme-toggle .icon {
		display: none;
	}

	.theme-toggle[data-mode='system'] .icon-system,
	.theme-toggle[data-mode='light'] .icon-light,
	.theme-toggle[data-mode='dark'] .icon-dark {
		display: block;
	}
</style>
