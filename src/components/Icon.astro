---
interface Props {
	name:
		| 'newspaper'
		| 'notebook-pen'
		| 'folder'
		| 'rocket'
		| 'sprout'
		| 'rss'
		| 'copyright'
		| 'github';
	size?: number;
	strokeWidth?: number;
}

const ICONS = {
