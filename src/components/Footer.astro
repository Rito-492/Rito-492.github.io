---
import Icon from './Icon.astro';
import { LICENSE, SITE } from '../config';
---

<footer>
	<p class="footer-line">
		© {new Date().getFullYear()} {SITE.author} · Powered by
		<a href="https://astro.build" target="_blank" rel="noopener noreferrer">
			Astro
		</a>{' '}
		& GitHub Pages
	</p>
	<p class="footer-links">
		<a href="/rss.xml" title="RSS 订阅" aria-label="RSS 订阅">
			<Icon name="rss" size={16} />
		</a>
		<a
			href={SITE.repo}
			target="_blank"
			rel="noopener noreferrer"
			title="网站源码"
			aria-label="网站源码"
		>
			<Icon name="github" size={16} />
		</a>
		<a
			href={LICENSE.deedUrl}
			target="_blank"
			rel="noopener noreferrer"
			title={LICENSE.name}
			aria-label={LICENSE.name}
		>
			<Icon name="copyright" size={16} />
		</a>
	</p>
</footer>

<style>
	footer {
		border-top: 1px solid var(--color-border);
		padding: 2rem;
		text-align: center;
		color: var(--color-text-muted);
		font-size: 0.8rem;
	}

	.footer-line {
		margin-bottom: 0.6rem;
	}

	.footer-line a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.footer-line a:hover {
		color: var(--color-primary);
	}

	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.footer-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-links a:hover {
		color: var(--color-primary);
	}
</style>
