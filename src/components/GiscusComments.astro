---
export interface Props {
	repo: string;
	repoId: string;
	category: string;
	categoryId: string;
	mapping?: 'pathname' | 'url' | 'title' | 'og:title';
	reactionsEnabled?: '0' | '1';
	theme?: string;
	lang?: string;
}

const {
	repo,
	repoId,
	category,
	categoryId,
	mapping = 'pathname',
	reactionsEnabled = '1',
	theme = 'light',
	lang = 'zh-CN',
} = Astro.props;

const config = { repo, repoId, category, categoryId, mapping, reactionsEnabled, theme, lang };
---

<div class="giscus" id="giscus-comments" data-config={JSON.stringify(config)}></div>
<div class="giscus-placeholder" id="giscus-placeholder">
	<p>加载评论中...</p>
</div>

<script is:inline>
	(function() {
		const el = document.getElementById('giscus-comments');
		const placeholder = document.getElementById('giscus-placeholder');
		if (!el) return;

		const cfg = JSON.parse(el.dataset.config);

		function loadGiscus() {
			const script = document.createElement('script');
			script.src = 'https://giscus.app/client.js';
			script.setAttribute('data-repo', cfg.repo);
			script.setAttribute('data-repo-id', cfg.repoId);
			script.setAttribute('data-category', cfg.category);
			script.setAttribute('data-category-id', cfg.categoryId);
			script.setAttribute('data-mapping', cfg.mapping);
			script.setAttribute('data-strict', '0');
			script.setAttribute('data-reactions-enabled', cfg.reactionsEnabled);
			script.setAttribute('data-emit-metadata', '0');
			script.setAttribute('data-input-position', 'top');
			script.setAttribute('data-theme', cfg.theme);
			script.setAttribute('data-lang', cfg.lang);
			script.crossOrigin = 'anonymous';
			script.async = true;
			el.appendChild(script);
			if (placeholder) placeholder.remove();
		}

		if ('requestIdleCallback' in window) {
			requestIdleCallback(loadGiscus, { timeout: 3000 });
		} else {
			setTimeout(loadGiscus, 2000);
		}
	})();
</script>

<style>
	.giscus {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.giscus-placeholder {
		text-align: center;
		padding: 2rem 0;
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}
</style>
