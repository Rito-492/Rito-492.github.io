---
// 文章页右侧边栏：系列 / 标签 / 目录
interface Props {
	series?: string;
	postTitle?: string;
	tags?: string[];
	tocHeadings?: Array<{ depth: number; text: string; id: string }>;
}

const { series = '', postTitle = '', tags = [], tocHeadings = [] } = Astro.props;
---

<aside class="toc-sidebar">
	{series && (
		<div class="toc-series">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
			</svg>
			<span>{series}</span>
		</div>
	)}
	{tags.length > 0 && (
		<div class="toc-label">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
			<span>标签</span>
		</div>
		<nav class="toc-tags">
			{tags.map(tag => (
				<a href={`/blog?tag=${encodeURIComponent(tag)}`} class="toc-tag">{tag}</a>
			))}
		</nav>
	)}
	<h3 class="toc-title">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
			<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
		</svg>
		{postTitle || '目录'}
	</h3>
	<nav class="toc-nav" id="tocNav">
		<ul>
			{tocHeadings.filter(h => h.depth >= 2 && h.depth <= 3).map((heading) => (
				<li class={`toc-item depth-${heading.depth}`}>
					<a href={`#${heading.id}`}>
						{heading.text}
					</a>
				</li>
			))}
		</ul>
	</nav>
</aside>

<style>
	/* 博客目录 TOC */
	.toc-sidebar {
		grid-column: 3;
		width: 100%;
		box-sizing: border-box;
		position: sticky;
		top: 5rem;
		height: fit-content;
		max-height: calc(100vh - 7rem);
		overflow-y: auto;
		padding: 1.25rem 0;
		border-left: 1px solid var(--color-border);
	}

	/* 系列名称 */
	.toc-series {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		padding-left: 0.25rem;
	}

	.toc-series svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	/* 标签标题 - 与系列名统一 */
	.toc-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		padding-left: 0.25rem;
	}

	.toc-label svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	/* 目录标题 - 统一样式 */
	.toc-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		padding-left: 0.25rem;
	}

	.toc-title svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}

	/* 目录导航 */
	.toc-nav ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-item {
		margin-bottom: 0.4rem;
	}

	.toc-item a {
		display: block;
		padding: 0.35rem 0.5rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		line-height: 1.5;
		transition: all 0.2s;
		border-left: 2px solid transparent;
	}

	.toc-item a:hover {
		color: var(--color-text);
		border-left-color: var(--color-primary);
	}

	.toc-item a.active {
		color: var(--color-primary);
		border-left-color: var(--color-primary);
		font-weight: 500;
	}

	.toc-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 1.25rem;
		padding-left: 0.5rem;
	}

	.toc-tag {
		font-size: 0.78rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.15s;
		white-space: nowrap;
	}

	.toc-tag:hover {
		color: var(--color-primary);
	}

	.toc-item.depth-3 a {
		padding-left: 1.25rem;
		font-size: 0.8rem;
	}

	@media (max-width: 1150px) {
		.toc-sidebar {
			display: none;
		}
	}
</style>
