---
import { SITE } from '../config';
import SocialLinks from './SocialLinks.astro';
---

<div class="profile-card">
	<div class="avatar">
		<img src={SITE.avatar} alt="avatar" width="64" height="64" decoding="async" />
	</div>
	<div class="profile-text">
		<h2 class="name">{SITE.author}</h2>
		<p class="bio">{SITE.bio}</p>
		<SocialLinks variant="stack" center />
	</div>
</div>

<style>
	/* 桌面左栏：头像与文字共用同一条垂直中心线 */
	.profile-card {
		padding: 0;
		text-align: center;
	}

	.avatar {
		width: 64px;
		height: 64px;
		margin: 0 auto 1rem;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.35rem;
	}

	.bio {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin-bottom: 1.25rem;
		line-height: 1.6;
	}

	/* 窄屏：左栏落回正文上方，身份卡变为紧凑横排 */
	@media (max-width: 1320px) {
		.profile-card {
			display: flex;
			align-items: center;
			text-align: left;
			gap: 1rem;
		}

		.avatar {
			width: 48px;
			height: 48px;
			margin: 0;
		}

		.name {
			font-size: 1.05rem;
			margin-bottom: 0.15rem;
		}

		.bio {
			font-size: 0.82rem;
			margin-bottom: 0.4rem;
		}
	}
</style>
