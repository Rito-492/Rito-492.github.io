---
// 首页左侧个人卡片
import { SITE } from '../config';
import SocialLinks from './SocialLinks.astro';
---

<div class="profile-card">
	<div class="avatar">
		<img src={SITE.avatar} alt="avatar" />
	</div>
	<h2 class="name">{SITE.author}</h2>
	<p class="bio">{SITE.bio}</p>
	<SocialLinks variant="stack" />
</div>

<style>
	.profile-card {
		padding: 0;
		text-align: left;
	}

	.avatar {
		width: 64px;
		height: 64px;
		margin: 0 0 1rem;
		border-radius: 50%;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.35rem;
	}

	.bio {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin-bottom: 1.5rem;
		line-height: 1.6;
	}
</style>
